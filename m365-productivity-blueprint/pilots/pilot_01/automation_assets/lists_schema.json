{
  "$comment": "Pilot 01 통합 업무요청 허브 데이터 구조. 내부 이름(internalName)은 영문으로 만들고 표시 이름만 한글로 바꾼다(Flow 표현식이 내부 이름을 쓰기 때문). 기존 시제품 List가 있으면 아래와 비교해 '추가할 열'만 만든다.",
  "site": "SCM 팀 사이트(Scenario B) 또는 개인 OneDrive 기반 Lists(Scenario A, 공유 제한)",
  "lists": [
    {
      "name": "RequestHub",
      "displayName": "업무요청 허브",
      "versioning": true,
      "purpose": "모든 부서 간 요청의 단일 원본. 요청 1건 = 1행.",
      "columns": [
        {"internalName": "Title", "displayName": "요청 제목", "type": "Text", "required": true},
        {"internalName": "RequestID", "displayName": "요청번호", "type": "Text", "required": false, "indexed": true, "setBy": "flow", "note": "REQ-yyyy-00000, SharePoint ID 기반이라 경합 없음"},
        {"internalName": "RequestType", "displayName": "요청유형", "type": "Choice", "required": true,
         "choices": ["시제품", "생산계획변경", "공급·배분조정", "재고확인", "데이터·분석요청", "기타"]},
        {"internalName": "Requester", "displayName": "요청자", "type": "User", "required": true},
        {"internalName": "RequestingDept", "displayName": "요청부서", "type": "Choice", "required": true,
         "choices": ["해외사업", "국내영업", "품질", "연구개발", "구매", "물류", "생산(공장)", "기타"]},
        {"internalName": "Plant", "displayName": "대상 공장", "type": "Choice", "required": false,
         "choices": ["PLT-A", "PLT-B", "PLT-C", "해외-1", "해외-2", "미정"]},
        {"internalName": "ProductCode", "displayName": "제품·SKU 코드", "type": "Text", "required": false, "indexed": true},
        {"internalName": "Quantity", "displayName": "수량", "type": "Number", "required": false, "min": 0},
        {"internalName": "DueDateRequested", "displayName": "희망 완료일", "type": "DateTime", "required": true, "dateOnly": true},
        {"internalName": "Priority", "displayName": "우선순위", "type": "Choice", "required": true,
         "choices": ["긴급", "높음", "보통", "낮음"], "default": "보통"},
        {"internalName": "Details", "displayName": "상세 내용", "type": "Note", "required": true},
        {"internalName": "Status", "displayName": "상태", "type": "Choice", "required": true, "indexed": true,
         "choices": ["접수", "정보보완", "검토중", "승인대기", "진행중", "보류", "완료", "반려", "취소"], "default": "접수"},
        {"internalName": "Owner", "displayName": "SCM 담당자", "type": "User", "required": false, "indexed": true, "setBy": "flow"},
        {"internalName": "SLATargetDate", "displayName": "SLA 목표일", "type": "DateTime", "required": false, "dateOnly": true, "indexed": true, "setBy": "flow"},
        {"internalName": "DueDateCommitted", "displayName": "약속 완료일", "type": "DateTime", "required": false, "dateOnly": true},
        {"internalName": "ChangeCount", "displayName": "약속일 변경 횟수", "type": "Number", "required": false, "default": 0, "setBy": "flow"},
        {"internalName": "LastChangeReason", "displayName": "최근 변경 사유", "type": "Note", "required": false},
        {"internalName": "ApprovalOutcome", "displayName": "승인 결과", "type": "Choice", "required": false,
         "choices": ["해당없음", "승인", "반려", "대기"], "default": "해당없음", "setBy": "flow"},
        {"internalName": "ClosedDate", "displayName": "종료일", "type": "DateTime", "required": false, "setBy": "flow"},
        {"internalName": "DuplicateKey", "displayName": "중복검사키", "type": "Text", "required": false, "indexed": true, "setBy": "flow", "hidden": true},
        {"internalName": "PrevStatus", "displayName": "이전 상태(시스템)", "type": "Text", "required": false, "setBy": "flow", "hidden": true,
         "note": "트리거 조건으로 Flow 자기 자신의 수정에 의한 무한 루프를 막는 열"},
        {"internalName": "PrevDueDateCommitted", "displayName": "이전 약속일(시스템)", "type": "Text", "required": false, "setBy": "flow", "hidden": true},
        {"internalName": "Source", "displayName": "접수 경로", "type": "Choice", "required": false,
         "choices": ["Lists 양식", "Teams 메시지", "이메일", "Power Apps"], "default": "Lists 양식"},
        {"internalName": "RelatedDecisionID", "displayName": "관련 결정번호", "type": "Text", "required": false, "note": "Pilot 03 DecisionLog 연결"}
      ],
      "views": [
        {"name": "내 담당(진행)", "filter": "Owner = [Me] AND Status NOT IN (완료, 반려, 취소)", "sort": "SLATargetDate asc"},
        {"name": "SLA 위험", "filter": "SLATargetDate <= [Today]+1 AND Status NOT IN (완료, 반려, 취소)", "sort": "SLATargetDate asc"},
        {"name": "내가 요청한 건", "filter": "Requester = [Me]", "sort": "Created desc"},
        {"name": "보드(상태별)", "type": "Board", "groupBy": "Status"}
      ],
      "permissions": "팀 사이트 구성원: 편집 / 요청 부서: '내가 요청한 건' 중심 기여(편집은 본인 작성 항목만: 목록 설정 > 고급 설정 > 항목 수준 권한)"
    },
    {
      "name": "RequestLog",
      "displayName": "요청 이력(감사)",
      "purpose": "상태·약속일 변경 이벤트 로그. 리드타임·SLA KPI 산출 원천. Flow만 쓴다(사용자 읽기 전용).",
      "columns": [
        {"internalName": "Title", "displayName": "요청번호", "type": "Text", "required": true},
        {"internalName": "RequestItemId", "displayName": "요청 항목 ID", "type": "Number", "required": true, "indexed": true},
        {"internalName": "EventType", "displayName": "이벤트", "type": "Choice", "required": true,
         "choices": ["생성", "상태변경", "약속일변경", "승인요청", "승인결과", "SLA경고", "에스컬레이션", "중복의심"]},
        {"internalName": "FromValue", "displayName": "변경 전", "type": "Text", "required": false},
        {"internalName": "ToValue", "displayName": "변경 후", "type": "Text", "required": false},
        {"internalName": "Actor", "displayName": "변경자", "type": "Text", "required": false},
        {"internalName": "EventAt", "displayName": "발생시각(UTC)", "type": "DateTime", "required": true},
        {"internalName": "Comment", "displayName": "비고", "type": "Note", "required": false},
        {"internalName": "FlowRunId", "displayName": "Flow 실행 ID", "type": "Text", "required": false, "indexed": true}
      ],
      "permissions": "팀원 읽기 / Flow 연결 계정만 추가"
    },
    {
      "name": "SLAPolicy",
      "displayName": "SLA 정책(설정)",
      "purpose": "요청유형별 처리기준. 코드 수정 없이 운영 규칙을 바꾸는 설정 테이블.",
      "columns": [
        {"internalName": "Title", "displayName": "요청유형", "type": "Text", "required": true, "unique": true},
        {"internalName": "SLABusinessDays", "displayName": "SLA(영업일)", "type": "Number", "required": true, "min": 0},
        {"internalName": "RequiresApproval", "displayName": "승인 필요", "type": "Boolean", "required": true},
        {"internalName": "ApproverEmail", "displayName": "승인자 이메일", "type": "Text", "required": false},
        {"internalName": "DefaultOwnerEmail", "displayName": "기본 담당자 이메일", "type": "Text", "required": true},
        {"internalName": "EscalationEmail", "displayName": "에스컬레이션 대상", "type": "Text", "required": true},
        {"internalName": "RequiredFields", "displayName": "필수 확인 항목", "type": "Text", "required": false, "note": "세미콜론 구분 내부이름. 예: Plant;ProductCode;Quantity"}
      ],
      "permissions": "팀장·관리자 편집 / 팀원 읽기"
    },
    {
      "name": "Holidays",
      "displayName": "휴무일(설정)",
      "purpose": "영업일 계산용 회사 휴무일. 회사 공식 달력으로 관리.",
      "columns": [
        {"internalName": "Title", "displayName": "휴무명", "type": "Text", "required": true},
        {"internalName": "HolidayDate", "displayName": "휴무일", "type": "DateTime", "required": true, "dateOnly": true, "indexed": true}
      ],
      "permissions": "관리자 편집 / 팀원 읽기"
    },
    {
      "name": "FlowErrorLog",
      "displayName": "자동화 오류 로그(공통)",
      "purpose": "모든 파일럿 Flow의 Catch 블록이 기록하는 공통 로그(O20).",
      "columns": [
        {"internalName": "Title", "displayName": "Flow 이름", "type": "Text", "required": true},
        {"internalName": "FlowRunId", "displayName": "실행 ID", "type": "Text", "required": true},
        {"internalName": "FailedAction", "displayName": "실패 액션", "type": "Text", "required": false},
        {"internalName": "ErrorMessage", "displayName": "오류 메시지", "type": "Note", "required": false},
        {"internalName": "RelatedItem", "displayName": "관련 항목", "type": "Text", "required": false},
        {"internalName": "Severity", "displayName": "심각도", "type": "Choice", "required": true, "choices": ["Critical", "Warning"]},
        {"internalName": "Resolved", "displayName": "조치완료", "type": "Boolean", "required": true, "default": false},
        {"internalName": "RunUrl", "displayName": "실행 기록 링크", "type": "Text", "required": false}
      ],
      "permissions": "자동화 운영자 편집 / 팀원 읽기"
    }
  ]
}
