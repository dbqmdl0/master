{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "회의 후속조치 확인 요청: {{MeetingName}} ({{MeetingDate}})",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "AI가 회의록에서 찾은 후보입니다. 근거 문장을 확인하고 등록할 항목만 선택하세요. 선택하지 않은 항목은 버려집니다.",
      "wrap": true,
      "isSubtle": true,
      "size": "Small"
    },
    {
      "type": "Input.Toggle",
      "id": "a1",
      "title": "{{A1_Title}} — {{A1_Owner}} / {{A1_Due}}",
      "value": "false",
      "valueOn": "true",
      "valueOff": "false",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "근거: \"{{A1_Evidence}}\"",
      "wrap": true,
      "isSubtle": true,
      "size": "Small"
    },
    {
      "type": "Input.Toggle",
      "id": "a2",
      "title": "{{A2_Title}} — {{A2_Owner}} / {{A2_Due}}",
      "value": "false",
      "valueOn": "true",
      "valueOff": "false",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "근거: \"{{A2_Evidence}}\"",
      "wrap": true,
      "isSubtle": true,
      "size": "Small"
    },
    {
      "type": "TextBlock",
      "text": "⚠ 확인 필요: {{NeedsReviewSummary}}",
      "color": "Warning",
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "선택 항목 등록"
    }
  ]
}
