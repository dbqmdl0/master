{
  "id": "P3P-F9",
  "name": "P3P-F9 승인된 후보 → 결정·액션 등록",
  "purpose": "사람이 ActionCandidates에서 '승인'으로 바꾼 후보만 등록. 최신 값 재확인으로 중복 등록 방지, 실패 시 후보에 사유 표시.",
  "trigger": {
    "kind": "SharePoint.WhenAnItemIsCreatedOrModified",
    "inputs": {
      "site": "{{SITE_URL}}",
      "list": "ActionCandidates"
    },
    "conditions": [
      "@and(equals(triggerOutputs()?['body/Status/Value'], '승인'), empty(triggerOutputs()?['body/CreatedItemID']))"
    ],
    "concurrency": 1
  },
  "actions": {
    "Config": {
      "type": "Compose",
      "note": "설정값 모음. 샌드박스→운영 전환 시 이 값만 바꾼다(트리거의 사이트·목록은 직접 다시 선택).",
      "inputs": {
        "site": "{{SITE_URL}}",
        "me": "{{ME}}",
        "hostWorkbook": "{{HOST_WORKBOOK}}",
        "scriptFolder": "{{SCRIPT_FOLDER}}",
        "prototypeMode": true,
        "channel": "{{NOTIFY_CHANNEL}}",
        "links": {
          "myActions": "{{VIEW_MY_ACTIONS}}",
          "decisionQueue": "{{VIEW_DECISION_QUEUE}}",
          "candidates": "{{VIEW_CANDIDATES}}"
        }
      },
      "runAfter": {}
    },
    "Try": {
      "type": "Scope",
      "runAfter": {
        "Config": [
          "Succeeded"
        ]
      },
      "actions": {
        "Recheck": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionCandidates",
            "id": "@triggerOutputs()?['body/ID']"
          },
          "note": "최신 값 재확인(동시 수정·중복 실행 방어)",
          "runAfter": {}
        },
        "If_already": {
          "type": "If",
          "expression": "@not(and(equals(body('Recheck')?['Status']?['Value'], '승인'), empty(body('Recheck')?['CreatedItemID'])))",
          "actions": {
            "Stop_already": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded",
                "runError": {
                  "code": "AlreadyHandled",
                  "message": "이미 처리된 후보"
                }
              },
              "runAfter": {}
            }
          },
          "note": "",
          "runAfter": {
            "Recheck": [
              "Succeeded"
            ]
          }
        },
        "If_kind_action": {
          "type": "If",
          "expression": "@equals(body('Recheck')?['Kind']?['Value'], '액션')",
          "actions": {
            "Validate_owner": {
              "type": "Connector",
              "connector": "Office 365 Users",
              "operation": "Get user profile (V2)",
              "inputs": {
                "user": "@{body('Recheck')?['OwnerEmail']}"
              },
              "note": "담당자 실존 확인(비어 있으면 실패)",
              "runAfter": {}
            },
            "Create_action": {
              "type": "Connector",
              "connector": "SharePoint",
              "operation": "Create item",
              "inputs": {
                "site": "@{outputs('Config')?['site']}",
                "list": "ActionItems",
                "item": {
                  "Title": "@{body('Recheck')?['Title']}",
                  "Owner/Claims": "@{body('Validate_owner')?['mail']}",
                  "DueDate": "@if(empty(body('Recheck')?['DueDate']), null, body('Recheck')?['DueDate'])",
                  "Status/Value": "미착수",
                  "ActionType/Value": "실행",
                  "Source/Value": "회의",
                  "Priority/Value": "보통",
                  "Evidence": "@{body('Recheck')?['Evidence']}",
                  "CreatedVia/Value": "AI 제안 승인"
                }
              },
              "note": "액션 등록",
              "runAfter": {
                "Validate_owner": [
                  "Succeeded"
                ]
              }
            },
            "Mark_done_action": {
              "type": "Connector",
              "connector": "SharePoint",
              "operation": "Update item",
              "inputs": {
                "site": "@{outputs('Config')?['site']}",
                "list": "ActionCandidates",
                "id": "@triggerOutputs()?['body/ID']",
                "item": {
                  "Title": "@{body('Recheck')?['Title']}",
                  "Kind/Value": "@{body('Recheck')?['Kind']?['Value']}",
                  "IntakeID": "@body('Recheck')?['IntakeID']",
                  "Verdict/Value": "@{body('Recheck')?['Verdict']?['Value']}",
                  "Status/Value": "등록완료",
                  "CreatedItemID": "@{string(body('Create_action')?['ID'])}"
                }
              },
              "note": "등록완료 표시",
              "runAfter": {
                "Create_action": [
                  "Succeeded"
                ]
              }
            }
          },
          "note": "종류별 등록",
          "else": {
            "actions": {
              "Create_decision": {
                "type": "Connector",
                "connector": "SharePoint",
                "operation": "Create item",
                "inputs": {
                  "site": "@{outputs('Config')?['site']}",
                  "list": "DecisionLog",
                  "item": {
                    "Title": "@{body('Recheck')?['Title']}",
                    "DecisionText": "@{concat(body('Recheck')?['Title'], ' / 근거: ', coalesce(body('Recheck')?['Evidence'], ''))}",
                    "Status/Value": "확정",
                    "MeetingName": "@{coalesce(body('Recheck')?['MeetingName'], '')}",
                    "MeetingDate": "@if(empty(body('Recheck')?['MeetingDate']), null, body('Recheck')?['MeetingDate'])",
                    "DecidedAt": "@if(empty(body('Recheck')?['MeetingDate']), convertFromUtc(utcNow(), 'Korea Standard Time', 'yyyy-MM-dd'), body('Recheck')?['MeetingDate'])",
                    "Decider/Claims": "@if(empty(body('Recheck')?['OwnerEmail']), null, body('Recheck')?['OwnerEmail'])",
                    "CreatedVia/Value": "AI 제안 승인"
                  }
                },
                "note": "결정 등록(확정)",
                "runAfter": {}
              },
              "Mark_done_decision": {
                "type": "Connector",
                "connector": "SharePoint",
                "operation": "Update item",
                "inputs": {
                  "site": "@{outputs('Config')?['site']}",
                  "list": "ActionCandidates",
                  "id": "@triggerOutputs()?['body/ID']",
                  "item": {
                    "Title": "@{body('Recheck')?['Title']}",
                    "Kind/Value": "@{body('Recheck')?['Kind']?['Value']}",
                    "IntakeID": "@body('Recheck')?['IntakeID']",
                    "Verdict/Value": "@{body('Recheck')?['Verdict']?['Value']}",
                    "Status/Value": "등록완료",
                    "CreatedItemID": "@{string(body('Create_decision')?['ID'])}"
                  }
                },
                "note": "등록완료 표시",
                "runAfter": {
                  "Create_decision": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {
            "If_already": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Failed_actions": {
          "type": "FilterArray",
          "note": "Try 안에서 실패한 액션만 추림",
          "inputs": {
            "from": "@result('Try')",
            "where": "@equals(item()?['status'], 'Failed')"
          },
          "runAfter": {}
        },
        "Log_error": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Create item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "FlowErrorLog",
            "item": {
              "Title": "@{workflow()?['tags']?['flowDisplayName']}",
              "FlowRunId": "@{workflow()?['run']?['name']}",
              "FailedAction": "@{coalesce(first(body('Failed_actions'))?['name'], '')}",
              "ErrorMessage": "@{coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음(실행 기록 확인)')}",
              "Severity/Value": "Critical",
              "Resolved": false,
              "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
            }
          },
          "note": "공통 오류 로그 기록",
          "runAfter": {
            "Failed_actions": [
              "Succeeded"
            ]
          }
        },
        "Mark_candidate_error": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Update item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionCandidates",
            "id": "@triggerOutputs()?['body/ID']",
            "item": {
              "Title": "@{triggerOutputs()?['body/Title']}",
              "Kind/Value": "@{triggerOutputs()?['body/Kind/Value']}",
              "IntakeID": "@triggerOutputs()?['body/IntakeID']",
              "Verdict/Value": "@{triggerOutputs()?['body/Verdict/Value']}",
              "Status/Value": "오류",
              "Reasons": "@{concat(coalesce(triggerOutputs()?['body/Reasons'], ''), ' / 등록 실패: ', coalesce(first(body('Failed_actions'))?['error']?['message'], first(body('Failed_actions'))?['name']))}"
            }
          },
          "note": "후보에 오류 표시(사용자가 고쳐 다시 승인)",
          "runAfter": {
            "Log_error": [
              "Succeeded"
            ]
          }
        },
        "Terminate_failed": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "FlowFailed",
              "message": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '?'))}"
            }
          },
          "runAfter": {
            "Mark_candidate_error": [
              "Succeeded",
              "Failed",
              "Skipped"
            ]
          }
        }
      },
      "note": "실행 후 구성: Try가 '실패함'·'시간 초과됨'일 때"
    }
  }
}
