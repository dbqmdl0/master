{
  "id": "P3P-F9",
  "name": "P3P-F9 승인된 후보 → 결정·액션 등록",
  "purpose": "사람이 ActionCandidates에서 '승인'으로 바꾼 후보만 등록. 최신 값 재확인으로 중복 등록 방지, 실패 시 후보에 사유 표시.",
  "trigger": {
    "kind": "SharePoint.WhenAnItemIsCreatedOrModified",
    "inputs": {
      "site": "{{SITE_URL}}",
      "list": "ActionCandidates"
    },
    "conditions": [
      "@and(equals(triggerOutputs()?['body/Status/Value'], '승인'), empty(triggerOutputs()?['body/CreatedItemID']))"
    ],
    "concurrency": 1
  },
  "actions": {
    "Config": {
      "type": "Compose",
      "note": "설정값 모음. 샌드박스→운영 전환 시 이 값만 바꾼다(트리거의 사이트·목록은 직접 다시 선택).",
      "inputs": {
        "site": "{{SITE_URL}}",
        "me": "{{ME}}",
        "hostWorkbook": "{{HOST_WORKBOOK}}",
        "scriptFolder": "{{SCRIPT_FOLDER}}",
        "prototypeMode": true,
        "channel": "{{NOTIFY_CHANNEL}}",
        "factoryFolder": "{{FACTORY_FOLDER}}",
        "links": {
          "myActions": "{{VIEW_MY_ACTIONS}}",
          "decisionQueue": "{{VIEW_DECISION_QUEUE}}",
          "candidates": "{{VIEW_CANDIDATES}}"
        }
      },
      "runAfter": {}
    },
    "Try": {
      "type": "Scope",
      "runAfter": {
        "Config": [
          "Succeeded"
        ]
      },
      "actions": {
        "Recheck": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionCandidates",
            "id": "@triggerOutputs()?['body/ID']"
          },
          "note": "최신 값 재확인(동시 수정·중복 실행 방어)",
          "runAfter": {}
        },
        "If_already": {
          "type": "If",
          "expression": "@not(and(equals(body('Recheck')?['Status']?['Value'], '승인'), empty(body('Recheck')?['CreatedItemID'])))",
          "actions": {
            "Stop_already": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded",
                "runError": {
                  "code": "AlreadyHandled",
                  "message": "이미 처리된 후보"
                }
              },
              "runAfter": {}
            }
          },
          "note": "",
          "runAfter": {
            "Recheck": [
              "Succeeded"
            ]
          }
        },
        "If_kind_action": {
          "type": "If",
          "expression": "@equals(body('Recheck')?['Kind']?['Value'], '액션')",
          "actions": {
            "Validate_owner": {
              "type": "Connector",
              "connector": "Office 365 Users",
              "operation": "Get user profile (V2)",
              "inputs": {
                "user": "@{body('Recheck')?['OwnerEmail']}"
              },
              "note": "담당자 실존 확인(비어 있으면 실패)",
              "runAfter": {}
            },
            "Create_action": {
              "type": "Connector",
              "connector": "SharePoint",
              "operation": "Create item",
              "inputs": {
                "site": "@{outputs('Config')?['site']}",
                "list": "ActionItems",
                "item": {
                  "Title": "@{body('Recheck')?['Title']}",
                  "Owner/Claims": "@{body('Validate_owner')?['mail']}",
                  "DueDate": "@if(empty(body('Recheck')?['DueDate']), null, body('Recheck')?['DueDate'])",
                  "Status/Value": "미착수",
                  "ActionType/Value": "실행",
                  "Source/Value": "회의",
                  "Priority/Value": "보통",
                  "Evidence": "@{body('Recheck')?['Evidence']}",
                  "CreatedVia/Value": "AI 제안 승인"
                }
              },
              "note": "액션 등록",
              "runAfter": {
                "Validate_owner": [
                  "Succeeded"
                ]
              }
            },
            "Mark_done_action": {
              "type": "Connector",
              "connector": "SharePoint",
              "operation": "Update item",
              "inputs": {
                "site": "@{outputs('Config')?['site']}",
                "list": "ActionCandidates",
                "id": "@triggerOutputs()?['body/ID']",
                "item": {
                  "Title": "@body('Recheck')?['Title']",
                  "Kind/Value": "@body('Recheck')?['Kind']?['Value']",
                  "IntakeID": "@body('Recheck')?['IntakeID']",
                  "Ref": "@body('Recheck')?['Ref']",
                  "MeetingName": "@body('Recheck')?['MeetingName']",
                  "MeetingDate": "@body('Recheck')?['MeetingDate']",
                  "OwnerName": "@body('Recheck')?['OwnerName']",
                  "OwnerEmail": "@body('Recheck')?['OwnerEmail']",
                  "DueDate": "@body('Recheck')?['DueDate']",
                  "Evidence": "@body('Recheck')?['Evidence']",
                  "Verdict/Value": "@body('Recheck')?['Verdict']?['Value']",
                  "Reasons": "@body('Recheck')?['Reasons']",
                  "Status/Value": "등록완료",
                  "CreatedItemID": "@{string(body('Create_action')?['ID'])}"
                }
              },
              "note": "등록완료 표시(다른 열 보존)",
              "preserve": {
                "from": "body('Recheck')",
                "changed": [
                  "Status/Value",
                  "CreatedItemID"
                ]
              },
              "runAfter": {
                "Create_action": [
                  "Succeeded"
                ]
              }
            }
          },
          "note": "종류별 등록",
          "else": {
            "actions": {
              "Create_decision": {
                "type": "Connector",
                "connector": "SharePoint",
                "operation": "Create item",
                "inputs": {
                  "site": "@{outputs('Config')?['site']}",
                  "list": "DecisionLog",
                  "item": {
                    "Title": "@{body('Recheck')?['Title']}",
                    "DecisionText": "@{concat(body('Recheck')?['Title'], ' / 회의록 근거: ', coalesce(body('Recheck')?['Evidence'], ''), if(empty(body('Recheck')?['OwnerName']), '', concat(' / AI 추정 관련자: ', body('Recheck')?['OwnerName'], '(미확인)')))}",
                    "Status/Value": "제안",
                    "MeetingName": "@{coalesce(body('Recheck')?['MeetingName'], '')}",
                    "MeetingDate": "@if(empty(body('Recheck')?['MeetingDate']), null, body('Recheck')?['MeetingDate'])",
                    "CreatedVia/Value": "AI 제안 승인"
                  }
                },
                "note": "AI 추출 결정은 '제안'으로 등록 — 결정권자·확정일은 비워 두고 사람이 확정(P0-6)",
                "runAfter": {}
              },
              "Mark_done_decision": {
                "type": "Connector",
                "connector": "SharePoint",
                "operation": "Update item",
                "inputs": {
                  "site": "@{outputs('Config')?['site']}",
                  "list": "ActionCandidates",
                  "id": "@triggerOutputs()?['body/ID']",
                  "item": {
                    "Title": "@body('Recheck')?['Title']",
                    "Kind/Value": "@body('Recheck')?['Kind']?['Value']",
                    "IntakeID": "@body('Recheck')?['IntakeID']",
                    "Ref": "@body('Recheck')?['Ref']",
                    "MeetingName": "@body('Recheck')?['MeetingName']",
                    "MeetingDate": "@body('Recheck')?['MeetingDate']",
                    "OwnerName": "@body('Recheck')?['OwnerName']",
                    "OwnerEmail": "@body('Recheck')?['OwnerEmail']",
                    "DueDate": "@body('Recheck')?['DueDate']",
                    "Evidence": "@body('Recheck')?['Evidence']",
                    "Verdict/Value": "@body('Recheck')?['Verdict']?['Value']",
                    "Reasons": "@body('Recheck')?['Reasons']",
                    "Status/Value": "등록완료",
                    "CreatedItemID": "@{string(body('Create_decision')?['ID'])}"
                  }
                },
                "note": "등록완료 표시(다른 열 보존)",
                "preserve": {
                  "from": "body('Recheck')",
                  "changed": [
                    "Status/Value",
                    "CreatedItemID"
                  ]
                },
                "runAfter": {
                  "Create_decision": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {
            "If_already": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Failed_actions": {
          "type": "FilterArray",
          "note": "Try 안에서 실패·시간 초과된 액션만 추림",
          "inputs": {
            "from": "@result('Try')",
            "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
          },
          "runAfter": {}
        },
        "Error_text": {
          "type": "Compose",
          "note": "오류 요약(민감 내용 없이 300자 이내). 조건·반복 안쪽 실패는 엔진이 상세를 올려 주지 않으므로 위치를 안내",
          "inputs": "@{if(greater(length(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음'))))), 300), substring(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))), 0, 300), if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))))}",
          "runAfter": {
            "Failed_actions": [
              "Succeeded"
            ]
          }
        },
        "Log_error": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Create item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "FlowErrorLog",
            "item": {
              "Title": "@{workflow()?['tags']?['flowDisplayName']}",
              "FlowRunId": "@{workflow()?['run']?['name']}",
              "FailedAction": "@{coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)')}",
              "ErrorMessage": "@{outputs('Error_text')}",
              "Severity/Value": "Critical",
              "Resolved": false,
              "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
            }
          },
          "note": "공통 오류 로그 기록",
          "runAfter": {
            "Error_text": [
              "Succeeded"
            ]
          }
        },
        "Log_failed_email": {
          "type": "Connector",
          "connector": "Office 365 Outlook",
          "operation": "Send an email (V2)",
          "runAfter": {
            "Log_error": [
              "Failed",
              "TimedOut"
            ]
          },
          "note": "오류 로그 기록 실패 시 본인 메일로 직접 알림(내용 없이 흐름 이름·실행 링크만)",
          "inputs": {
            "to": "@{outputs('Config')?['me']}",
            "subject": "@{concat('[P3 오류] ', workflow()?['tags']?['flowDisplayName'], ' — 오류 로그 기록도 실패')}",
            "body": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'), '<br>FlowErrorLog 목록 권한·연결을 확인하세요.<br>실행 기록: https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
          }
        },
        "Get_candidate_now": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionCandidates",
            "id": "@triggerOutputs()?['body/ID']"
          },
          "note": "후보 최신 값",
          "runAfter": {
            "Log_failed_email": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Mark_candidate_error": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Update item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionCandidates",
            "id": "@triggerOutputs()?['body/ID']",
            "item": {
              "Title": "@body('Get_candidate_now')?['Title']",
              "Kind/Value": "@body('Get_candidate_now')?['Kind']?['Value']",
              "IntakeID": "@body('Get_candidate_now')?['IntakeID']",
              "Ref": "@body('Get_candidate_now')?['Ref']",
              "MeetingName": "@body('Get_candidate_now')?['MeetingName']",
              "MeetingDate": "@body('Get_candidate_now')?['MeetingDate']",
              "OwnerName": "@body('Get_candidate_now')?['OwnerName']",
              "OwnerEmail": "@body('Get_candidate_now')?['OwnerEmail']",
              "DueDate": "@body('Get_candidate_now')?['DueDate']",
              "Evidence": "@body('Get_candidate_now')?['Evidence']",
              "Verdict/Value": "@body('Get_candidate_now')?['Verdict']?['Value']",
              "CreatedItemID": "@body('Get_candidate_now')?['CreatedItemID']",
              "Status/Value": "오류",
              "Reasons": "@{concat(coalesce(body('Get_candidate_now')?['Reasons'], ''), ' / 등록 실패: ', outputs('Error_text'))}"
            }
          },
          "note": "후보에 오류 표시(사용자가 고쳐 다시 승인, 다른 열 보존)",
          "runAfter": {
            "Get_candidate_now": [
              "Succeeded"
            ]
          },
          "preserve": {
            "from": "body('Get_candidate_now')",
            "changed": [
              "Status/Value",
              "Reasons"
            ]
          }
        },
        "Terminate_failed": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "FlowFailed",
              "message": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'))}"
            }
          },
          "runAfter": {
            "Mark_candidate_error": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      },
      "note": "실행 후 구성: Try가 '실패함'·'시간 초과됨'일 때"
    }
  }
}
