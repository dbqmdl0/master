{
  "id": "P3P-F7",
  "name": "P3P-F7 액션 리마인더(담당자별 하루 1장)",
  "purpose": "평일 08:30 기한 D-1·당일·초과 액션을 담당자별 1장으로 알림. 같은 날 재알림 없음. 프로토타입 모드는 본인에게만.",
  "trigger": {
    "kind": "Recurrence",
    "recurrence": {
      "frequency": "Week",
      "interval": 1,
      "timeZone": "Korea Standard Time",
      "schedule": {
        "weekDays": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ],
        "hours": [
          8
        ],
        "minutes": [
          30
        ]
      }
    }
  },
  "actions": {
    "Config": {
      "type": "Compose",
      "note": "설정값 모음. 샌드박스→운영 전환 시 이 값만 바꾼다(트리거의 사이트·목록은 직접 다시 선택).",
      "inputs": {
        "site": "{{SITE_URL}}",
        "me": "{{ME}}",
        "hostWorkbook": "{{HOST_WORKBOOK}}",
        "scriptFolder": "{{SCRIPT_FOLDER}}",
        "prototypeMode": true,
        "channel": "{{NOTIFY_CHANNEL}}",
        "factoryFolder": "{{FACTORY_FOLDER}}",
        "links": {
          "myActions": "{{VIEW_MY_ACTIONS}}",
          "decisionQueue": "{{VIEW_DECISION_QUEUE}}",
          "candidates": "{{VIEW_CANDIDATES}}"
        }
      },
      "runAfter": {}
    },
    "Today": {
      "type": "Compose",
      "inputs": "@{convertFromUtc(utcNow(), 'Korea Standard Time', 'yyyy-MM-dd')}",
      "note": "오늘(KST)",
      "runAfter": {
        "Config": [
          "Succeeded"
        ]
      }
    },
    "DayStartUtc": {
      "type": "Compose",
      "inputs": "@{convertToUtc(concat(outputs('Today'), 'T00:00:00'), 'Korea Standard Time')}",
      "note": "오늘 0시(KST)를 UTC로",
      "runAfter": {
        "Today": [
          "Succeeded"
        ]
      }
    },
    "Init_skipped": {
      "type": "InitializeVariable",
      "inputs": {
        "name": "varSkipped",
        "type": "Array",
        "value": []
      },
      "runAfter": {
        "DayStartUtc": [
          "Succeeded"
        ]
      }
    },
    "Try": {
      "type": "Scope",
      "runAfter": {
        "Init_skipped": [
          "Succeeded"
        ]
      },
      "actions": {
        "Get_holidays": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get items",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "Holidays",
            "top": 500
          },
          "note": "휴무일",
          "runAfter": {}
        },
        "Get_due_actions": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get items",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionItems",
            "filter": "(Status eq '미착수' or Status eq '진행중') and DueDate le '@{addDays(outputs('Today'), 1, 'yyyy-MM-dd')}'",
            "top": 2000
          },
          "note": "내일까지 기한인 미결 액션",
          "runAfter": {
            "Get_holidays": [
              "Succeeded"
            ]
          }
        },
        "Run_digest": {
          "type": "Connector",
          "connector": "Excel Online (Business)",
          "operation": "Run script",
          "inputs": {
            "location": "OneDrive for Business",
            "documentLibrary": "OneDrive",
            "file": "@{outputs('Config')?['hostWorkbook']}",
            "script": "BuildReminderDigest",
            "parameters": {
              "todayKst": "@{outputs('Today')}",
              "actionsJson": "@{string(body('Get_due_actions')?['value'])}",
              "holidaysJson": "@{string(body('Get_holidays')?['value'])}",
              "viewUrl": "@{outputs('Config')?['links']?['myActions']}"
            }
          },
          "note": "담당자별 카드 생성(Office Scripts) · 스크립트 위치: 본인 OneDrive 문서/Office Scripts",
          "runAfter": {
            "Get_due_actions": [
              "Succeeded"
            ]
          }
        },
        "If_skip": {
          "type": "If",
          "expression": "@equals(body('Run_digest')?['result']?['skip'], true)",
          "actions": {
            "Stop_skip": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded",
                "runError": {
                  "code": "Skip",
                  "message": "@{body('Run_digest')?['result']?['reason']}"
                }
              },
              "runAfter": {}
            }
          },
          "note": "",
          "runAfter": {
            "Run_digest": [
              "Succeeded"
            ]
          }
        },
        "For_each_digest": {
          "type": "Foreach",
          "foreach": "@body('Run_digest')?['result']?['digests']",
          "note": "담당자별 반복(동시성 1)",
          "actions": {
            "If_allowed": {
              "type": "If",
              "expression": "@or(not(outputs('Config')?['prototypeMode']), equals(toLower(items('For_each_digest')?['ownerEmail']), toLower(outputs('Config')?['me'])))",
              "actions": {
                "Post_digest": {
                  "type": "If",
                  "expression": "@equals(outputs('Config')?['channel'], 'teams')",
                  "actions": {
                    "Post_digest_teams": {
                      "type": "Connector",
                      "connector": "Microsoft Teams",
                      "operation": "Post card in a chat or channel",
                      "inputs": {
                        "poster": "Flow bot",
                        "location": "Chat with Flow bot",
                        "recipient": "@{items('For_each_digest')?['ownerEmail']}",
                        "card": "@{items('For_each_digest')?['cardJson']}"
                      },
                      "note": "Teams Flow bot 카드",
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Post_digest_email": {
                        "type": "Connector",
                        "connector": "Office 365 Outlook",
                        "operation": "Send an email (V2)",
                        "inputs": {
                          "to": "@{items('For_each_digest')?['ownerEmail']}",
                          "subject": "@{concat('[액션 리마인더] ', outputs('Today'))}",
                          "body": "@{items('For_each_digest')?['htmlSummary']}"
                        },
                        "note": "메일 알림(Workflows 앱 없을 때)",
                        "runAfter": {}
                      }
                    }
                  },
                  "note": "담당자에게 하루 1장 — 설정 channel 이 teams 면 Teams, 아니면 메일",
                  "runAfter": {}
                },
                "For_each_item": {
                  "type": "Foreach",
                  "foreach": "@items('For_each_digest')?['itemIds']",
                  "note": "알린 항목 기록",
                  "actions": {
                    "Get_action": {
                      "type": "Connector",
                      "connector": "SharePoint",
                      "operation": "Get item",
                      "inputs": {
                        "site": "@{outputs('Config')?['site']}",
                        "list": "ActionItems",
                        "id": "@items('For_each_item')"
                      },
                      "note": "현재 값 읽기(Update 필수 입력용)",
                      "runAfter": {}
                    },
                    "Mark_reminded": {
                      "type": "Connector",
                      "connector": "SharePoint",
                      "operation": "Update item",
                      "inputs": {
                        "site": "@{outputs('Config')?['site']}",
                        "list": "ActionItems",
                        "id": "@items('For_each_item')",
                        "item": {
                          "Title": "@body('Get_action')?['Title']",
                          "ActionID": "@body('Get_action')?['ActionID']",
                          "DecisionID": "@body('Get_action')?['DecisionID']",
                          "Owner/Claims": "@body('Get_action')?['Owner']?['Claims']",
                          "DueDate": "@body('Get_action')?['DueDate']",
                          "Status/Value": "@body('Get_action')?['Status']?['Value']",
                          "Priority/Value": "@body('Get_action')?['Priority']?['Value']",
                          "ActionType/Value": "@body('Get_action')?['ActionType']?['Value']",
                          "Source/Value": "@body('Get_action')?['Source']?['Value']",
                          "SourceLink": "@body('Get_action')?['SourceLink']",
                          "Evidence": "@body('Get_action')?['Evidence']",
                          "CompletedAt": "@body('Get_action')?['CompletedAt']",
                          "CreatedVia/Value": "@body('Get_action')?['CreatedVia']?['Value']",
                          "DueHint": "@body('Get_action')?['DueHint']",
                          "SourceMessageId": "@body('Get_action')?['SourceMessageId']",
                          "SourceKey": "@body('Get_action')?['SourceKey']",
                          "FlagDue": "@body('Get_action')?['FlagDue']",
                          "SyncNote": "@body('Get_action')?['SyncNote']",
                          "PrevStatus": "@body('Get_action')?['PrevStatus']",
                          "DueHintChecked": "@body('Get_action')?['DueHintChecked']",
                          "ReminderCount": "@add(coalesce(body('Get_action')?['ReminderCount'], 0), 1)",
                          "LastRemindedAt": "@{utcNow()}"
                        }
                      },
                      "note": "리마인더 횟수·시각만 갱신(모든 열 보존)",
                      "preserve": {
                        "from": "body('Get_action')",
                        "changed": [
                          "ReminderCount",
                          "LastRemindedAt"
                        ]
                      },
                      "runAfter": {
                        "Get_action": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Post_digest": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "note": "프로토타입 모드에서는 본인에게만 발송",
              "else": {
                "actions": {
                  "Remember_skipped": {
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "varSkipped",
                      "value": "@items('For_each_digest')?['ownerEmail']"
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "If_skip": [
              "Succeeded"
            ]
          }
        },
        "If_any_skipped": {
          "type": "If",
          "expression": "@greater(length(variables('varSkipped')), 0)",
          "actions": {
            "Tell_skipped": {
              "type": "If",
              "expression": "@equals(outputs('Config')?['channel'], 'teams')",
              "actions": {
                "Tell_skipped_teams": {
                  "type": "Connector",
                  "connector": "Microsoft Teams",
                  "operation": "Post message in a chat or channel",
                  "inputs": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "recipient": "@{outputs('Config')?['me']}",
                    "message": "@{concat('프로토타입 모드: 다른 담당자 ', string(length(variables('varSkipped'))), '명에게는 발송하지 않았습니다.')}"
                  },
                  "note": "Teams Flow bot 메시지",
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {
                  "Tell_skipped_email": {
                    "type": "Connector",
                    "connector": "Office 365 Outlook",
                    "operation": "Send an email (V2)",
                    "inputs": {
                      "to": "@{outputs('Config')?['me']}",
                      "subject": "[P3 알림]",
                      "body": "@{concat('프로토타입 모드: 다른 담당자 ', string(length(variables('varSkipped'))), '명에게는 발송하지 않았습니다.')}"
                    },
                    "note": "메일 알림(Workflows 앱 없을 때)",
                    "runAfter": {}
                  }
                }
              },
              "note": "본인에게 알림(Teams 메시지 또는 메일) — 설정 channel 이 teams 면 Teams, 아니면 메일",
              "runAfter": {}
            }
          },
          "note": "",
          "runAfter": {
            "For_each_digest": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Failed_actions": {
          "type": "FilterArray",
          "note": "Try 안에서 실패·시간 초과된 액션만 추림",
          "inputs": {
            "from": "@result('Try')",
            "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
          },
          "runAfter": {}
        },
        "Error_text": {
          "type": "Compose",
          "note": "오류 요약(민감 내용 없이 300자 이내). 조건·반복 안쪽 실패는 엔진이 상세를 올려 주지 않으므로 위치를 안내",
          "inputs": "@{if(greater(length(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음'))))), 300), substring(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))), 0, 300), if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))))}",
          "runAfter": {
            "Failed_actions": [
              "Succeeded"
            ]
          }
        },
        "Log_error": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Create item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "FlowErrorLog",
            "item": {
              "Title": "@{workflow()?['tags']?['flowDisplayName']}",
              "FlowRunId": "@{workflow()?['run']?['name']}",
              "FailedAction": "@{coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)')}",
              "ErrorMessage": "@{outputs('Error_text')}",
              "Severity/Value": "Critical",
              "Resolved": false,
              "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
            }
          },
          "note": "공통 오류 로그 기록",
          "runAfter": {
            "Error_text": [
              "Succeeded"
            ]
          }
        },
        "Log_failed_email": {
          "type": "Connector",
          "connector": "Office 365 Outlook",
          "operation": "Send an email (V2)",
          "runAfter": {
            "Log_error": [
              "Failed",
              "TimedOut"
            ]
          },
          "note": "오류 로그 기록 실패 시 본인 메일로 직접 알림(내용 없이 흐름 이름·실행 링크만)",
          "inputs": {
            "to": "@{outputs('Config')?['me']}",
            "subject": "@{concat('[P3 오류] ', workflow()?['tags']?['flowDisplayName'], ' — 오류 로그 기록도 실패')}",
            "body": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'), '<br>FlowErrorLog 목록 권한·연결을 확인하세요.<br>실행 기록: https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
          }
        },
        "Terminate_failed": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "FlowFailed",
              "message": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'))}"
            }
          },
          "runAfter": {
            "Log_failed_email": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      },
      "note": "실행 후 구성: Try가 '실패함'·'시간 초과됨'일 때"
    }
  }
}
