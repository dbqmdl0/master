{
  "id": "P3P-F5",
  "name": "P3P-F5 Teams 메시지 → 결정·액션 기록",
  "purpose": "Teams 메시지 '추가 작업'에서 결정·결정요청·액션을 기록. 같은 메시지 두 번 기록 방지, 담당자 실존 확인.",
  "trigger": {
    "kind": "Teams.ForASelectedMessage",
    "inputs": {
      "inputCard": "../automation_assets/cards/capture_decision_action.json"
    }
  },
  "actions": {
    "Config": {
      "type": "Compose",
      "note": "설정값 모음. 샌드박스→운영 전환 시 이 값만 바꾼다(트리거의 사이트·목록은 직접 다시 선택).",
      "inputs": {
        "site": "{{SITE_URL}}",
        "me": "{{ME}}",
        "hostWorkbook": "{{HOST_WORKBOOK}}",
        "scriptFolder": "{{SCRIPT_FOLDER}}",
        "prototypeMode": true,
        "channel": "{{NOTIFY_CHANNEL}}",
        "factoryFolder": "{{FACTORY_FOLDER}}",
        "links": {
          "myActions": "{{VIEW_MY_ACTIONS}}",
          "decisionQueue": "{{VIEW_DECISION_QUEUE}}",
          "candidates": "{{VIEW_CANDIDATES}}"
        }
      },
      "runAfter": {}
    },
    "Try": {
      "type": "Scope",
      "runAfter": {
        "Config": [
          "Succeeded"
        ]
      },
      "actions": {
        "Content": {
          "type": "Compose",
          "note": "메시지 본문 앞 1,000자(근거로 저장)",
          "inputs": "@{if(greater(length(coalesce(triggerBody()?['messagePayload']?['body']?['content'], '')), 1000), substring(triggerBody()?['messagePayload']?['body']?['content'], 0, 1000), coalesce(triggerBody()?['messagePayload']?['body']?['content'], ''))}",
          "runAfter": {}
        },
        "Inputs": {
          "type": "Compose",
          "note": "카드 입력값 정리(담당자 비면 나)",
          "inputs": {
            "kind": "@{coalesce(triggerBody()?['cardOutputs']?['kind'], '액션')}",
            "title": "@{trim(coalesce(triggerBody()?['cardOutputs']?['title'], ''))}",
            "owner": "@{toLower(if(empty(triggerBody()?['cardOutputs']?['ownerEmail']), outputs('Config')?['me'], trim(triggerBody()?['cardOutputs']?['ownerEmail'])))}",
            "due": "@{coalesce(triggerBody()?['cardOutputs']?['dueDate'], '')}",
            "decisionId": "@{trim(coalesce(triggerBody()?['cardOutputs']?['decisionId'], ''))}",
            "messageId": "@{coalesce(triggerBody()?['messagePayload']?['id'], '')}",
            "link": "@{coalesce(triggerBody()?['linkToMessage'], '')}"
          },
          "runAfter": {
            "Content": [
              "Succeeded"
            ]
          }
        },
        "Validate_inputs": {
          "type": "If",
          "expression": "@or(empty(outputs('Inputs')?['title']), empty(outputs('Inputs')?['messageId']))",
          "actions": {
            "Tell_missing": {
              "type": "If",
              "expression": "@equals(outputs('Config')?['channel'], 'teams')",
              "actions": {
                "Tell_missing_teams": {
                  "type": "Connector",
                  "connector": "Microsoft Teams",
                  "operation": "Post message in a chat or channel",
                  "inputs": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "recipient": "@{outputs('Config')?['me']}",
                    "message": "기록하지 않았습니다: 제목 또는 메시지 정보가 비어 있습니다."
                  },
                  "note": "Teams Flow bot 메시지",
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {
                  "Tell_missing_email": {
                    "type": "Connector",
                    "connector": "Office 365 Outlook",
                    "operation": "Send an email (V2)",
                    "inputs": {
                      "to": "@{outputs('Config')?['me']}",
                      "subject": "[P3 알림]",
                      "body": "기록하지 않았습니다: 제목 또는 메시지 정보가 비어 있습니다."
                    },
                    "note": "메일 알림(Workflows 앱 없을 때)",
                    "runAfter": {}
                  }
                }
              },
              "note": "본인에게 알림(Teams 메시지 또는 메일) — 설정 channel 이 teams 면 Teams, 아니면 메일",
              "runAfter": {}
            },
            "Stop_missing": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "InputMissing",
                  "message": "제목 또는 메시지 ID 누락"
                }
              },
              "runAfter": {
                "Tell_missing": [
                  "Succeeded"
                ]
              }
            }
          },
          "note": "데이터 누락 방어",
          "runAfter": {
            "Inputs": [
              "Succeeded"
            ]
          }
        },
        "Check_owner": {
          "type": "Connector",
          "connector": "Office 365 Users",
          "operation": "Get user profile (V2)",
          "inputs": {
            "user": "@{outputs('Inputs')?['owner']}"
          },
          "note": "담당자 이메일이 실제 사용자인지 확인",
          "runAfter": {
            "Validate_inputs": [
              "Succeeded"
            ]
          }
        },
        "If_action": {
          "type": "If",
          "expression": "@equals(outputs('Inputs')?['kind'], '액션')",
          "actions": {
            "Find_dup_action": {
              "type": "Connector",
              "connector": "SharePoint",
              "operation": "Get items",
              "inputs": {
                "site": "@{outputs('Config')?['site']}",
                "list": "ActionItems",
                "filter": "SourceMessageId eq '@{replace(outputs('Inputs')?['messageId'], '''', '''''')}'",
                "top": 1
              },
              "note": "같은 메시지 중복 확인",
              "runAfter": {}
            },
            "If_dup_action": {
              "type": "If",
              "expression": "@greater(length(body('Find_dup_action')?['value']), 0)",
              "actions": {
                "Tell_dup_action": {
                  "type": "If",
                  "expression": "@equals(outputs('Config')?['channel'], 'teams')",
                  "actions": {
                    "Tell_dup_action_teams": {
                      "type": "Connector",
                      "connector": "Microsoft Teams",
                      "operation": "Post message in a chat or channel",
                      "inputs": {
                        "poster": "Flow bot",
                        "location": "Chat with Flow bot",
                        "recipient": "@{outputs('Config')?['me']}",
                        "message": "이미 기록된 메시지입니다(중복 생성 안 함)."
                      },
                      "note": "Teams Flow bot 메시지",
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Tell_dup_action_email": {
                        "type": "Connector",
                        "connector": "Office 365 Outlook",
                        "operation": "Send an email (V2)",
                        "inputs": {
                          "to": "@{outputs('Config')?['me']}",
                          "subject": "[P3 알림]",
                          "body": "이미 기록된 메시지입니다(중복 생성 안 함)."
                        },
                        "note": "메일 알림(Workflows 앱 없을 때)",
                        "runAfter": {}
                      }
                    }
                  },
                  "note": "본인에게 알림(Teams 메시지 또는 메일) — 설정 channel 이 teams 면 Teams, 아니면 메일",
                  "runAfter": {}
                },
                "Stop_dup_action": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded",
                    "runError": {
                      "code": "Duplicate",
                      "message": "이미 기록됨"
                    }
                  },
                  "runAfter": {
                    "Tell_dup_action": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "note": "",
              "runAfter": {
                "Find_dup_action": [
                  "Succeeded"
                ]
              }
            },
            "Create_action": {
              "type": "Connector",
              "connector": "SharePoint",
              "operation": "Create item",
              "inputs": {
                "site": "@{outputs('Config')?['site']}",
                "list": "ActionItems",
                "item": {
                  "Title": "@{outputs('Inputs')?['title']}",
                  "Owner/Claims": "@{outputs('Inputs')?['owner']}",
                  "DueDate": "@if(empty(outputs('Inputs')?['due']), null, outputs('Inputs')?['due'])",
                  "Status/Value": "미착수",
                  "ActionType/Value": "실행",
                  "Source/Value": "Teams 메시지",
                  "CreatedVia/Value": "Teams 메시지",
                  "Priority/Value": "보통",
                  "SourceLink": "@{outputs('Inputs')?['link']}",
                  "Evidence": "@{outputs('Content')}",
                  "DecisionID": "@{outputs('Inputs')?['decisionId']}",
                  "SourceMessageId": "@{outputs('Inputs')?['messageId']}"
                }
              },
              "note": "액션 등록",
              "runAfter": {
                "If_dup_action": [
                  "Succeeded"
                ]
              }
            }
          },
          "note": "종류별 분기: 액션 / 결정·결정요청",
          "else": {
            "actions": {
              "Find_dup_decision": {
                "type": "Connector",
                "connector": "SharePoint",
                "operation": "Get items",
                "inputs": {
                  "site": "@{outputs('Config')?['site']}",
                  "list": "DecisionLog",
                  "filter": "SourceMessageId eq '@{replace(outputs('Inputs')?['messageId'], '''', '''''')}'",
                  "top": 1
                },
                "note": "같은 메시지 중복 확인",
                "runAfter": {}
              },
              "If_dup_decision": {
                "type": "If",
                "expression": "@greater(length(body('Find_dup_decision')?['value']), 0)",
                "actions": {
                  "Tell_dup_decision": {
                    "type": "If",
                    "expression": "@equals(outputs('Config')?['channel'], 'teams')",
                    "actions": {
                      "Tell_dup_decision_teams": {
                        "type": "Connector",
                        "connector": "Microsoft Teams",
                        "operation": "Post message in a chat or channel",
                        "inputs": {
                          "poster": "Flow bot",
                          "location": "Chat with Flow bot",
                          "recipient": "@{outputs('Config')?['me']}",
                          "message": "이미 기록된 메시지입니다(중복 생성 안 함)."
                        },
                        "note": "Teams Flow bot 메시지",
                        "runAfter": {}
                      }
                    },
                    "else": {
                      "actions": {
                        "Tell_dup_decision_email": {
                          "type": "Connector",
                          "connector": "Office 365 Outlook",
                          "operation": "Send an email (V2)",
                          "inputs": {
                            "to": "@{outputs('Config')?['me']}",
                            "subject": "[P3 알림]",
                            "body": "이미 기록된 메시지입니다(중복 생성 안 함)."
                          },
                          "note": "메일 알림(Workflows 앱 없을 때)",
                          "runAfter": {}
                        }
                      }
                    },
                    "note": "본인에게 알림(Teams 메시지 또는 메일) — 설정 channel 이 teams 면 Teams, 아니면 메일",
                    "runAfter": {}
                  },
                  "Stop_dup_decision": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Succeeded",
                      "runError": {
                        "code": "Duplicate",
                        "message": "이미 기록됨"
                      }
                    },
                    "runAfter": {
                      "Tell_dup_decision": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "note": "",
                "runAfter": {
                  "Find_dup_decision": [
                    "Succeeded"
                  ]
                }
              },
              "Create_decision": {
                "type": "Connector",
                "connector": "SharePoint",
                "operation": "Create item",
                "inputs": {
                  "site": "@{outputs('Config')?['site']}",
                  "list": "DecisionLog",
                  "item": {
                    "Title": "@{outputs('Inputs')?['title']}",
                    "DecisionText": "@{concat(outputs('Inputs')?['title'], ' / 원문: ', outputs('Content'))}",
                    "Status/Value": "@{if(equals(outputs('Inputs')?['kind'], '결정요청'), '결정요청', '제안')}",
                    "Decider/Claims": "@{outputs('Inputs')?['owner']}",
                    "RequestedBy/Claims": "@{outputs('Config')?['me']}",
                    "SourceLink": "@{outputs('Inputs')?['link']}",
                    "CreatedVia/Value": "Teams 메시지",
                    "SourceMessageId": "@{outputs('Inputs')?['messageId']}"
                  }
                },
                "note": "결정요청 또는 '제안'으로 기록(확정은 사람이 목록에서 — P0-6)",
                "runAfter": {
                  "If_dup_decision": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {
            "Check_owner": [
              "Succeeded"
            ]
          }
        },
        "Tell_done": {
          "type": "If",
          "expression": "@equals(outputs('Config')?['channel'], 'teams')",
          "actions": {
            "Tell_done_teams": {
              "type": "Connector",
              "connector": "Microsoft Teams",
              "operation": "Post message in a chat or channel",
              "inputs": {
                "poster": "Flow bot",
                "location": "Chat with Flow bot",
                "recipient": "@{outputs('Config')?['me']}",
                "message": "@{concat('기록됨(', if(equals(outputs('Inputs')?['kind'], '결정'), '결정 → 제안 상태, 확정은 목록에서', outputs('Inputs')?['kind']), '): ', outputs('Inputs')?['title'], ' — 번호는 잠시 후 목록에서 확인')}"
              },
              "note": "Teams Flow bot 메시지",
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Tell_done_email": {
                "type": "Connector",
                "connector": "Office 365 Outlook",
                "operation": "Send an email (V2)",
                "inputs": {
                  "to": "@{outputs('Config')?['me']}",
                  "subject": "[P3 알림]",
                  "body": "@{concat('기록됨(', if(equals(outputs('Inputs')?['kind'], '결정'), '결정 → 제안 상태, 확정은 목록에서', outputs('Inputs')?['kind']), '): ', outputs('Inputs')?['title'], ' — 번호는 잠시 후 목록에서 확인')}"
                },
                "note": "메일 알림(Workflows 앱 없을 때)",
                "runAfter": {}
              }
            }
          },
          "note": "본인에게 알림(Teams 메시지 또는 메일) — 설정 channel 이 teams 면 Teams, 아니면 메일",
          "runAfter": {
            "If_action": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Failed_actions": {
          "type": "FilterArray",
          "note": "Try 안에서 실패·시간 초과된 액션만 추림",
          "inputs": {
            "from": "@result('Try')",
            "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
          },
          "runAfter": {}
        },
        "Error_text": {
          "type": "Compose",
          "note": "오류 요약(민감 내용 없이 300자 이내). 조건·반복 안쪽 실패는 엔진이 상세를 올려 주지 않으므로 위치를 안내",
          "inputs": "@{if(greater(length(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음'))))), 300), substring(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))), 0, 300), if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))))}",
          "runAfter": {
            "Failed_actions": [
              "Succeeded"
            ]
          }
        },
        "Log_error": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Create item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "FlowErrorLog",
            "item": {
              "Title": "@{workflow()?['tags']?['flowDisplayName']}",
              "FlowRunId": "@{workflow()?['run']?['name']}",
              "FailedAction": "@{coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)')}",
              "ErrorMessage": "@{outputs('Error_text')}",
              "Severity/Value": "Critical",
              "Resolved": false,
              "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
            }
          },
          "note": "공통 오류 로그 기록",
          "runAfter": {
            "Error_text": [
              "Succeeded"
            ]
          }
        },
        "Log_failed_email": {
          "type": "Connector",
          "connector": "Office 365 Outlook",
          "operation": "Send an email (V2)",
          "runAfter": {
            "Log_error": [
              "Failed",
              "TimedOut"
            ]
          },
          "note": "오류 로그 기록 실패 시 본인 메일로 직접 알림(내용 없이 흐름 이름·실행 링크만)",
          "inputs": {
            "to": "@{outputs('Config')?['me']}",
            "subject": "@{concat('[P3 오류] ', workflow()?['tags']?['flowDisplayName'], ' — 오류 로그 기록도 실패')}",
            "body": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'), '<br>FlowErrorLog 목록 권한·연결을 확인하세요.<br>실행 기록: https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
          }
        },
        "Terminate_failed": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "FlowFailed",
              "message": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'))}"
            }
          },
          "runAfter": {
            "Log_failed_email": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      },
      "note": "실행 후 구성: Try가 '실패함'·'시간 초과됨'일 때"
    }
  }
}
