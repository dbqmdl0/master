{
  "id": "P3P-F13",
  "name": "P3P-F13 메일 문구로 기한 자동 제안",
  "purpose": "번호가 붙은(P3P-F3 이후) 플래그 할 일 중 등록된 할 일에 기한이 없으면 메일 제목·미리보기의 '내일까지·10/30까지·금요일까지·긴급' 같은 표현으로 기한·우선순위를 채우고 근거를 남김.",
  "trigger": {
    "kind": "SharePoint.WhenAnItemIsCreatedOrModified",
    "inputs": {
      "site": "{{SITE_URL}}",
      "list": "ActionItems"
    },
    "conditions": [
      "@and(not(empty(triggerOutputs()?['body/ActionID'])), empty(triggerOutputs()?['body/DueDate']), empty(triggerOutputs()?['body/DueHintChecked']), equals(triggerOutputs()?['body/CreatedVia/Value'], 'Outlook 플래그'))"
    ]
  },
  "actions": {
    "Config": {
      "type": "Compose",
      "note": "설정값 모음. 샌드박스→운영 전환 시 이 값만 바꾼다(트리거의 사이트·목록은 직접 다시 선택).",
      "inputs": {
        "site": "{{SITE_URL}}",
        "me": "{{ME}}",
        "hostWorkbook": "{{HOST_WORKBOOK}}",
        "scriptFolder": "{{SCRIPT_FOLDER}}",
        "prototypeMode": true,
        "channel": "{{NOTIFY_CHANNEL}}",
        "factoryFolder": "{{FACTORY_FOLDER}}",
        "links": {
          "myActions": "{{VIEW_MY_ACTIONS}}",
          "decisionQueue": "{{VIEW_DECISION_QUEUE}}",
          "candidates": "{{VIEW_CANDIDATES}}"
        }
      },
      "runAfter": {}
    },
    "Try": {
      "type": "Scope",
      "runAfter": {
        "Config": [
          "Succeeded"
        ]
      },
      "actions": {
        "Recheck": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionItems",
            "id": "@triggerOutputs()?['body/ID']"
          },
          "note": "최신 값 재확인(중복 실행 방어)",
          "runAfter": {}
        },
        "If_already": {
          "type": "If",
          "expression": "@not(and(empty(body('Recheck')?['DueDate']), empty(body('Recheck')?['DueHintChecked']), not(equals(body('Recheck')?['Status']?['Value'], '완료')), not(equals(body('Recheck')?['Status']?['Value'], '취소'))))",
          "actions": {
            "Stop_already": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded",
                "runError": {
                  "code": "AlreadyHandled",
                  "message": "이미 기한이 있거나 추정 완료"
                }
              },
              "runAfter": {}
            }
          },
          "note": "",
          "runAfter": {
            "Recheck": [
              "Succeeded"
            ]
          }
        },
        "Get_holidays": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get items",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "Holidays",
            "top": 500
          },
          "note": "휴무일(내일·모레 계산용)",
          "runAfter": {
            "If_already": [
              "Succeeded"
            ]
          }
        },
        "Run_hint": {
          "type": "Connector",
          "connector": "Excel Online (Business)",
          "operation": "Run script",
          "inputs": {
            "location": "OneDrive for Business",
            "documentLibrary": "OneDrive",
            "file": "@{outputs('Config')?['hostWorkbook']}",
            "script": "ParseDueHint",
            "parameters": {
              "text": "@{concat(body('Recheck')?['Title'], ' ', coalesce(body('Recheck')?['Evidence'], ''))}",
              "receivedKst": "@{convertFromUtc(body('Recheck')?['Created'], 'Korea Standard Time', 'yyyy-MM-dd')}",
              "holidaysJson": "@{string(body('Get_holidays')?['value'])}"
            }
          },
          "note": "기한·긴급도 추정(Office Scripts) · 스크립트 위치: 본인 OneDrive 문서/Office Scripts",
          "runAfter": {
            "Get_holidays": [
              "Succeeded"
            ]
          }
        },
        "Update_hint": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Update item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionItems",
            "id": "@triggerOutputs()?['body/ID']",
            "item": {
              "Title": "@body('Recheck')?['Title']",
              "ActionID": "@body('Recheck')?['ActionID']",
              "DecisionID": "@body('Recheck')?['DecisionID']",
              "Owner/Claims": "@body('Recheck')?['Owner']?['Claims']",
              "Status/Value": "@body('Recheck')?['Status']?['Value']",
              "ActionType/Value": "@body('Recheck')?['ActionType']?['Value']",
              "Source/Value": "@body('Recheck')?['Source']?['Value']",
              "SourceLink": "@body('Recheck')?['SourceLink']",
              "Evidence": "@body('Recheck')?['Evidence']",
              "CompletedAt": "@body('Recheck')?['CompletedAt']",
              "ReminderCount": "@body('Recheck')?['ReminderCount']",
              "LastRemindedAt": "@body('Recheck')?['LastRemindedAt']",
              "CreatedVia/Value": "@body('Recheck')?['CreatedVia']?['Value']",
              "SourceMessageId": "@body('Recheck')?['SourceMessageId']",
              "SourceKey": "@body('Recheck')?['SourceKey']",
              "SyncNote": "@body('Recheck')?['SyncNote']",
              "PrevStatus": "@body('Recheck')?['PrevStatus']",
              "DueDate": "@if(empty(body('Run_hint')?['result']?['dueDate']), null, body('Run_hint')?['result']?['dueDate'])",
              "FlagDue": "@if(empty(body('Run_hint')?['result']?['dueDate']), null, body('Run_hint')?['result']?['dueDate'])",
              "Priority/Value": "@{if(equals(body('Run_hint')?['result']?['priority'], '높음'), '높음', coalesce(body('Recheck')?['Priority']?['Value'], '보통'))}",
              "DueHint": "@{if(empty(body('Run_hint')?['result']?['phrase']), '근거 없음 — 직접 입력', concat('메일 문구 [', body('Run_hint')?['result']?['phrase'], ']에서 추정'))}",
              "DueHintChecked": "Y"
            }
          },
          "note": "기한·우선순위·근거만 갱신(사람이 언제든 수정 가능, 다른 열 보존)",
          "preserve": {
            "from": "body('Recheck')",
            "changed": [
              "DueDate",
              "FlagDue",
              "Priority/Value",
              "DueHint",
              "DueHintChecked"
            ]
          },
          "runAfter": {
            "Run_hint": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Failed_actions": {
          "type": "FilterArray",
          "note": "Try 안에서 실패·시간 초과된 액션만 추림",
          "inputs": {
            "from": "@result('Try')",
            "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
          },
          "runAfter": {}
        },
        "Error_text": {
          "type": "Compose",
          "note": "오류 요약(민감 내용 없이 300자 이내). 조건·반복 안쪽 실패는 엔진이 상세를 올려 주지 않으므로 위치를 안내",
          "inputs": "@{if(greater(length(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음'))))), 300), substring(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))), 0, 300), if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))))}",
          "runAfter": {
            "Failed_actions": [
              "Succeeded"
            ]
          }
        },
        "Log_error": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Create item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "FlowErrorLog",
            "item": {
              "Title": "@{workflow()?['tags']?['flowDisplayName']}",
              "FlowRunId": "@{workflow()?['run']?['name']}",
              "FailedAction": "@{coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)')}",
              "ErrorMessage": "@{outputs('Error_text')}",
              "Severity/Value": "Critical",
              "Resolved": false,
              "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
            }
          },
          "note": "공통 오류 로그 기록",
          "runAfter": {
            "Error_text": [
              "Succeeded"
            ]
          }
        },
        "Log_failed_email": {
          "type": "Connector",
          "connector": "Office 365 Outlook",
          "operation": "Send an email (V2)",
          "runAfter": {
            "Log_error": [
              "Failed",
              "TimedOut"
            ]
          },
          "note": "오류 로그 기록 실패 시 본인 메일로 직접 알림(내용 없이 흐름 이름·실행 링크만)",
          "inputs": {
            "to": "@{outputs('Config')?['me']}",
            "subject": "@{concat('[P3 오류] ', workflow()?['tags']?['flowDisplayName'], ' — 오류 로그 기록도 실패')}",
            "body": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'), '<br>FlowErrorLog 목록 권한·연결을 확인하세요.<br>실행 기록: https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
          }
        },
        "Terminate_failed": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "FlowFailed",
              "message": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'))}"
            }
          },
          "runAfter": {
            "Log_failed_email": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      },
      "note": "실행 후 구성: Try가 '실패함'·'시간 초과됨'일 때"
    }
  }
}
