{
  "id": "P3P-F6",
  "name": "P3P-F6 아침 브리핑",
  "purpose": "평일 07:40 본인에게 '오늘 먼저 처리할 5가지' 카드. 계산은 Office Scripts, Teams 실패 시 본인 메일로 대체.",
  "trigger": {
    "kind": "Recurrence",
    "recurrence": {
      "frequency": "Week",
      "interval": 1,
      "timeZone": "Korea Standard Time",
      "schedule": {
        "weekDays": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ],
        "hours": [
          7
        ],
        "minutes": [
          40
        ]
      }
    }
  },
  "actions": {
    "Config": {
      "type": "Compose",
      "note": "설정값 모음. 샌드박스→운영 전환 시 이 값만 바꾼다(트리거의 사이트·목록은 직접 다시 선택).",
      "inputs": {
        "site": "{{SITE_URL}}",
        "me": "{{ME}}",
        "hostWorkbook": "{{HOST_WORKBOOK}}",
        "scriptFolder": "{{SCRIPT_FOLDER}}",
        "prototypeMode": true,
        "channel": "{{NOTIFY_CHANNEL}}",
        "factoryFolder": "{{FACTORY_FOLDER}}",
        "links": {
          "myActions": "{{VIEW_MY_ACTIONS}}",
          "decisionQueue": "{{VIEW_DECISION_QUEUE}}",
          "candidates": "{{VIEW_CANDIDATES}}"
        }
      },
      "runAfter": {}
    },
    "Today": {
      "type": "Compose",
      "inputs": "@{convertFromUtc(utcNow(), 'Korea Standard Time', 'yyyy-MM-dd')}",
      "note": "오늘(KST)",
      "runAfter": {
        "Config": [
          "Succeeded"
        ]
      }
    },
    "DayStartUtc": {
      "type": "Compose",
      "inputs": "@{convertToUtc(concat(outputs('Today'), 'T00:00:00'), 'Korea Standard Time')}",
      "note": "오늘 0시(KST)를 UTC로",
      "runAfter": {
        "Today": [
          "Succeeded"
        ]
      }
    },
    "Try": {
      "type": "Scope",
      "runAfter": {
        "DayStartUtc": [
          "Succeeded"
        ]
      },
      "actions": {
        "Get_holidays": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get items",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "Holidays",
            "top": 500
          },
          "note": "휴무일",
          "runAfter": {}
        },
        "Get_events": {
          "type": "Connector",
          "connector": "Office 365 Outlook",
          "operation": "Get calendar view of events (V3)",
          "inputs": {
            "calendarId": "Calendar",
            "startTime": "@{outputs('DayStartUtc')}",
            "endTime": "@{addDays(outputs('DayStartUtc'), 1)}"
          },
          "note": "오늘 일정",
          "runAfter": {
            "Get_holidays": [
              "Succeeded"
            ]
          }
        },
        "Get_my_actions": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get items",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "ActionItems",
            "filter": "Owner/EMail eq '@{outputs('Config')?['me']}' and (Status eq '미착수' or Status eq '진행중')",
            "top": 500
          },
          "note": "내 미결 액션",
          "runAfter": {
            "Get_events": [
              "Succeeded"
            ]
          }
        },
        "Get_my_decisions": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Get items",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "DecisionLog",
            "filter": "(Status eq '결정요청' and Decider/EMail eq '@{outputs('Config')?['me']}') or (Status eq '제안' and Author/EMail eq '@{outputs('Config')?['me']}')",
            "top": 200
          },
          "note": "내가 결정할 대기 건 + 내가 확정해야 할 제안",
          "runAfter": {
            "Get_my_actions": [
              "Succeeded"
            ]
          }
        },
        "Run_brief": {
          "type": "Connector",
          "connector": "Excel Online (Business)",
          "operation": "Run script",
          "inputs": {
            "location": "OneDrive for Business",
            "documentLibrary": "OneDrive",
            "file": "@{outputs('Config')?['hostWorkbook']}",
            "script": "BuildDailyBrief",
            "parameters": {
              "meEmail": "@{outputs('Config')?['me']}",
              "todayKst": "@{outputs('Today')}",
              "eventsJson": "@{string(body('Get_events')?['value'])}",
              "actionsJson": "@{string(body('Get_my_actions')?['value'])}",
              "decisionsJson": "@{string(body('Get_my_decisions')?['value'])}",
              "requestsJson": "[]",
              "holidaysJson": "@{string(body('Get_holidays')?['value'])}",
              "linksJson": "@{string(outputs('Config')?['links'])}"
            }
          },
          "note": "점수 계산·카드 생성(Office Scripts) · 스크립트 위치: 본인 OneDrive 문서/Office Scripts",
          "runAfter": {
            "Get_my_decisions": [
              "Succeeded"
            ]
          }
        },
        "If_skip": {
          "type": "If",
          "expression": "@equals(body('Run_brief')?['result']?['skip'], true)",
          "actions": {
            "Stop_skip": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded",
                "runError": {
                  "code": "Skip",
                  "message": "@{body('Run_brief')?['result']?['reason']}"
                }
              },
              "runAfter": {}
            }
          },
          "note": "주말·휴무일이면 게시 안 함",
          "runAfter": {
            "Run_brief": [
              "Succeeded"
            ]
          }
        },
        "Post_card": {
          "type": "If",
          "expression": "@equals(outputs('Config')?['channel'], 'teams')",
          "actions": {
            "Post_card_teams": {
              "type": "Connector",
              "connector": "Microsoft Teams",
              "operation": "Post card in a chat or channel",
              "inputs": {
                "poster": "Flow bot",
                "location": "Chat with Flow bot",
                "recipient": "@{outputs('Config')?['me']}",
                "card": "@{body('Run_brief')?['result']?['cardJson']}"
              },
              "note": "Teams Flow bot 카드",
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Post_card_email": {
                "type": "Connector",
                "connector": "Office 365 Outlook",
                "operation": "Send an email (V2)",
                "inputs": {
                  "to": "@{outputs('Config')?['me']}",
                  "subject": "@{concat('[아침 브리핑] ', outputs('Today'))}",
                  "body": "@{body('Run_brief')?['result']?['htmlSummary']}"
                },
                "note": "메일 알림(Workflows 앱 없을 때)",
                "runAfter": {}
              }
            }
          },
          "note": "본인에게 알림(카드 또는 메일) — 설정 channel 이 teams 면 Teams, 아니면 메일",
          "runAfter": {
            "If_skip": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "Catch": {
      "type": "Scope",
      "runAfter": {
        "Try": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Failed_actions": {
          "type": "FilterArray",
          "note": "Try 안에서 실패·시간 초과된 액션만 추림",
          "inputs": {
            "from": "@result('Try')",
            "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
          },
          "runAfter": {}
        },
        "Error_text": {
          "type": "Compose",
          "note": "오류 요약(민감 내용 없이 300자 이내). 조건·반복 안쪽 실패는 엔진이 상세를 올려 주지 않으므로 위치를 안내",
          "inputs": "@{if(greater(length(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음'))))), 300), substring(if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))), 0, 300), if(empty(body('Failed_actions')), '실패 액션을 식별하지 못했습니다(실행 기록 링크 확인)', if(equals(first(body('Failed_actions'))?['error']?['code'], 'ActionFailed'), concat('[', first(body('Failed_actions'))?['name'], '] 안쪽 단계가 실패했습니다 — 실행 기록 링크에서 빨간 단계의 오류를 확인하세요'), concat(coalesce(first(body('Failed_actions'))?['error']?['code'], ''), ' ', coalesce(first(body('Failed_actions'))?['error']?['message'], '상세 메시지 없음')))))}",
          "runAfter": {
            "Failed_actions": [
              "Succeeded"
            ]
          }
        },
        "Log_error": {
          "type": "Connector",
          "connector": "SharePoint",
          "operation": "Create item",
          "inputs": {
            "site": "@{outputs('Config')?['site']}",
            "list": "FlowErrorLog",
            "item": {
              "Title": "@{workflow()?['tags']?['flowDisplayName']}",
              "FlowRunId": "@{workflow()?['run']?['name']}",
              "FailedAction": "@{coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)')}",
              "ErrorMessage": "@{outputs('Error_text')}",
              "Severity/Value": "Critical",
              "Resolved": false,
              "RunUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
            }
          },
          "note": "공통 오류 로그 기록",
          "runAfter": {
            "Error_text": [
              "Succeeded"
            ]
          }
        },
        "Log_failed_email": {
          "type": "Connector",
          "connector": "Office 365 Outlook",
          "operation": "Send an email (V2)",
          "runAfter": {
            "Log_error": [
              "Failed",
              "TimedOut"
            ]
          },
          "note": "오류 로그 기록 실패 시 본인 메일로 직접 알림(내용 없이 흐름 이름·실행 링크만)",
          "inputs": {
            "to": "@{outputs('Config')?['me']}",
            "subject": "@{concat('[P3 오류] ', workflow()?['tags']?['flowDisplayName'], ' — 오류 로그 기록도 실패')}",
            "body": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'), '<br>FlowErrorLog 목록 권한·연결을 확인하세요.<br>실행 기록: https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
          }
        },
        "If_teams_failed": {
          "type": "If",
          "expression": "@and(equals(first(body('Failed_actions'))?['name'], 'Post_card'), equals(outputs('Config')?['channel'], 'teams'))",
          "actions": {
            "Email_fallback": {
              "type": "Connector",
              "connector": "Office 365 Outlook",
              "operation": "Send an email (V2)",
              "inputs": {
                "to": "@{outputs('Config')?['me']}",
                "subject": "[아침 브리핑] Teams 게시 실패 — 메일로 대체",
                "body": "@{body('Run_brief')?['result']?['htmlSummary']}"
              },
              "note": "Teams 카드 실패 시 본인 메일로 대체 발송",
              "runAfter": {}
            }
          },
          "note": "Teams 실패 시 대체",
          "runAfter": {
            "Log_failed_email": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Terminate_failed": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "FlowFailed",
              "message": "@{concat('실패 액션: ', coalesce(first(body('Failed_actions'))?['name'], '(식별 불가)'))}"
            }
          },
          "runAfter": {
            "If_teams_failed": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      },
      "note": "실행 후 구성: Try가 '실패함'·'시간 초과됨'일 때"
    }
  }
}
