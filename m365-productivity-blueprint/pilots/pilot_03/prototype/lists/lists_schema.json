{
  "$comment": "Pilot 03 프로토타입 목록 구조(7개). 프로토타입은 본인 '내 목록'(OneDrive) 또는 팀 사이트에 SBX_ 접두어로 만든다. 운영 전환 시 같은 구조로 팀 사이트에 만든다.",
  "lists": [
    {
      "name": "ActionItems",
      "displayName": "액션 아이템",
      "versioning": true,
      "purpose": "결정·회의·메일에서 생긴 후속조치의 단일 원본. 회의록·주간보고·진행현황 회의를 대체한다.",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "할 일",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "ActionID",
          "displayName": "액션번호",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow"
        },
        {
          "internalName": "DecisionID",
          "displayName": "결정번호",
          "type": "Text",
          "required": false,
          "indexed": true
        },
        {
          "internalName": "Owner",
          "displayName": "담당자",
          "type": "User",
          "required": true,
          "indexed": true
        },
        {
          "internalName": "DueDate",
          "displayName": "기한",
          "type": "DateTime",
          "required": false,
          "dateOnly": true,
          "indexed": true
        },
        {
          "internalName": "Status",
          "displayName": "상태",
          "type": "Choice",
          "required": true,
          "indexed": true,
          "choices": [
            "미착수",
            "진행중",
            "완료",
            "보류",
            "취소"
          ],
          "default": "미착수"
        },
        {
          "internalName": "Priority",
          "displayName": "우선순위",
          "type": "Choice",
          "required": false,
          "choices": [
            "높음",
            "보통",
            "낮음"
          ],
          "default": "보통"
        },
        {
          "internalName": "ActionType",
          "displayName": "유형",
          "type": "Choice",
          "required": true,
          "choices": [
            "실행",
            "회신대기"
          ],
          "default": "실행"
        },
        {
          "internalName": "Source",
          "displayName": "출처",
          "type": "Choice",
          "required": false,
          "choices": [
            "회의",
            "이메일",
            "Teams 메시지",
            "업무요청",
            "기타"
          ],
          "default": "회의"
        },
        {
          "internalName": "SourceLink",
          "displayName": "원문 링크",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "Evidence",
          "displayName": "근거 문장",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "CompletedAt",
          "displayName": "완료일시",
          "type": "DateTime",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "ReminderCount",
          "displayName": "리마인더 횟수",
          "type": "Number",
          "required": false,
          "default": 0,
          "setBy": "flow"
        },
        {
          "internalName": "LastRemindedAt",
          "displayName": "최근 리마인더",
          "type": "DateTime",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "CreatedVia",
          "displayName": "등록 경로",
          "type": "Choice",
          "required": false,
          "choices": [
            "수동",
            "Teams 메시지",
            "Outlook 플래그",
            "AI 제안 승인"
          ],
          "default": "수동"
        },
        {
          "internalName": "SourceMessageId",
          "displayName": "원본 메시지 ID(시스템)",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow",
          "hidden": true,
          "note": "같은 메일·메시지로 액션이 두 번 생기지 않게 하는 중복 방지 키"
        },
        {
          "internalName": "PrevStatus",
          "displayName": "이전 상태(시스템)",
          "type": "Text",
          "required": false,
          "setBy": "flow",
          "hidden": true
        }
      ],
      "views": [
        {
          "name": "내 액션",
          "filter": "Owner = [Me] AND Status IN (미착수, 진행중)",
          "sort": "DueDate asc"
        },
        {
          "name": "기한 초과",
          "filter": "DueDate < [Today] AND Status IN (미착수, 진행중)",
          "sort": "DueDate asc"
        },
        {
          "name": "이번 주 완료",
          "filter": "Status = 완료 AND CompletedAt >= [Today]-7"
        },
        {
          "name": "보드",
          "type": "Board",
          "groupBy": "Status"
        }
      ],
      "permissions": "SCM 팀 및 회의 참석 부서 편집(본인 항목 상태 변경), 관리자 전체"
    },
    {
      "name": "DecisionLog",
      "displayName": "결정 레지스터",
      "versioning": true,
      "purpose": "회의·채팅·메일에서 나온 '결정'의 단일 원본. 결정 1건 = 1행. 근거와 번복 이력까지 남긴다.",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "결정 제목",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "DecisionID",
          "displayName": "결정번호",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow"
        },
        {
          "internalName": "DecisionText",
          "displayName": "결정 내용",
          "type": "Note",
          "required": true
        },
        {
          "internalName": "Rationale",
          "displayName": "근거·전제",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "OptionsConsidered",
          "displayName": "검토한 대안",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "Status",
          "displayName": "상태",
          "type": "Choice",
          "required": true,
          "indexed": true,
          "choices": [
            "제안",
            "결정요청",
            "확정",
            "보류",
            "번복"
          ],
          "default": "확정"
        },
        {
          "internalName": "Decider",
          "displayName": "결정권자",
          "type": "User",
          "required": false,
          "indexed": true
        },
        {
          "internalName": "RequestedBy",
          "displayName": "결정 요청자",
          "type": "User",
          "required": false
        },
        {
          "internalName": "RequestedAt",
          "displayName": "결정 요청일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "DecidedAt",
          "displayName": "확정일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "MeetingName",
          "displayName": "회의명",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "MeetingDate",
          "displayName": "회의일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "Impact",
          "displayName": "영향도",
          "type": "Choice",
          "required": false,
          "choices": [
            "고",
            "중",
            "저"
          ],
          "default": "중"
        },
        {
          "internalName": "ReviewDate",
          "displayName": "재검토일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "SourceLink",
          "displayName": "원문 링크",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "RelatedRequestID",
          "displayName": "관련 요청번호",
          "type": "Text",
          "required": false,
          "indexed": true
        },
        {
          "internalName": "SupersededBy",
          "displayName": "대체한 결정번호",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "CreatedVia",
          "displayName": "등록 경로",
          "type": "Choice",
          "required": false,
          "choices": [
            "수동",
            "Teams 메시지",
            "Outlook 플래그",
            "AI 제안 승인"
          ],
          "default": "수동"
        },
        {
          "internalName": "PrevStatus",
          "displayName": "이전 상태(시스템)",
          "type": "Text",
          "required": false,
          "setBy": "flow",
          "hidden": true
        },
        {
          "internalName": "SourceMessageId",
          "displayName": "원본 메시지 ID(시스템)",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow",
          "hidden": true
        }
      ],
      "views": [
        {
          "name": "결정 대기열",
          "filter": "Status = 결정요청",
          "sort": "RequestedAt asc"
        },
        {
          "name": "나의 결정 대기",
          "filter": "Status = 결정요청 AND Decider = [Me]",
          "sort": "RequestedAt asc"
        },
        {
          "name": "최근 확정 30일",
          "filter": "Status = 확정 AND DecidedAt >= [Today]-30",
          "sort": "DecidedAt desc"
        },
        {
          "name": "재검토 도래",
          "filter": "ReviewDate <= [Today]+7 AND Status = 확정"
        }
      ],
      "permissions": "SCM 팀 편집 / 협업 부서 읽기(결정 공유가 목적). 민감 결정은 별도 목록 또는 항목 권한."
    },
    {
      "name": "MeetingIntake",
      "displayName": "회의 추출 접수",
      "versioning": true,
      "purpose": "Copilot이 만든 결정·액션 JSON과 회의록 원문을 붙여넣는 접수 목록. 저장하면 검증 흐름(P3P-F8)이 자동 실행된다.",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "회의명",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "MeetingDate",
          "displayName": "회의일",
          "type": "DateTime",
          "required": true,
          "dateOnly": true
        },
        {
          "internalName": "Transcript",
          "displayName": "회의록 원문",
          "type": "Note",
          "required": true,
          "note": "전사본·메모 원문. 근거 검사(G2)에 사용"
        },
        {
          "internalName": "ExtractionJson",
          "displayName": "Copilot 추출 결과",
          "type": "Note",
          "required": true,
          "note": "Copilot 응답 전체를 그대로 붙여넣기(코드 블록 표시 포함 가능)"
        },
        {
          "internalName": "Status",
          "displayName": "처리 상태",
          "type": "Choice",
          "required": true,
          "choices": [
            "접수",
            "검증완료",
            "오류",
            "재검증요청"
          ],
          "default": "접수"
        },
        {
          "internalName": "RecommendedCount",
          "displayName": "추천 후보 수",
          "type": "Number",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "ReviewCount",
          "displayName": "검토필요 후보 수",
          "type": "Number",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "ResultSummary",
          "displayName": "검증 요약",
          "type": "Note",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "ProcessedAt",
          "displayName": "처리 시각",
          "type": "DateTime",
          "required": false,
          "setBy": "flow"
        }
      ],
      "views": [
        {
          "name": "최근 접수",
          "sort": "Created desc"
        }
      ],
      "permissions": "본인(프로토타입) → SCM 팀 편집(운영)"
    },
    {
      "name": "ActionCandidates",
      "displayName": "AI 후보(확인 대기)",
      "versioning": true,
      "purpose": "검증 가드를 거친 결정·액션 후보. 사람이 '승인'으로 바꾼 행만 ActionItems/DecisionLog에 등록된다(Human-in-the-loop).",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "후보 내용",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "Kind",
          "displayName": "종류",
          "type": "Choice",
          "required": true,
          "choices": [
            "결정",
            "액션"
          ]
        },
        {
          "internalName": "IntakeID",
          "displayName": "접수 항목 ID",
          "type": "Number",
          "required": true,
          "indexed": true
        },
        {
          "internalName": "Ref",
          "displayName": "추출 순번",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "MeetingName",
          "displayName": "회의명",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "MeetingDate",
          "displayName": "회의일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "OwnerName",
          "displayName": "담당자(추출 이름)",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "OwnerEmail",
          "displayName": "담당자 이메일(확인·수정 가능)",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "DueDate",
          "displayName": "기한(확인·수정 가능)",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "Evidence",
          "displayName": "근거 문장",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "Verdict",
          "displayName": "가드 판정",
          "type": "Choice",
          "required": true,
          "choices": [
            "추천",
            "검토필요"
          ]
        },
        {
          "internalName": "Reasons",
          "displayName": "검토 사유",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "Status",
          "displayName": "처리",
          "type": "Choice",
          "required": true,
          "indexed": true,
          "choices": [
            "제안",
            "승인",
            "기각",
            "등록완료",
            "오류"
          ],
          "default": "제안"
        },
        {
          "internalName": "CreatedItemID",
          "displayName": "등록된 항목 ID(시스템)",
          "type": "Text",
          "required": false,
          "setBy": "flow",
          "indexed": true
        }
      ],
      "views": [
        {
          "name": "확인 대기",
          "filter": "Status = 제안",
          "sort": "IntakeID desc, Ref asc"
        }
      ],
      "permissions": "본인(프로토타입) → 회의 주관자 편집(운영)"
    },
    {
      "name": "TeamRoster",
      "displayName": "팀 명부(담당자 매핑)",
      "purpose": "AI가 추출한 이름을 이메일로 바꾸는 유일한 근거(G3). AI가 이메일을 만들지 못하게 한다.",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "이름",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "Email",
          "displayName": "이메일",
          "type": "Text",
          "required": true,
          "indexed": true
        },
        {
          "internalName": "Aliases",
          "displayName": "별칭(; 구분)",
          "type": "Text",
          "required": false
        }
      ],
      "permissions": "팀장 편집 / 팀원 읽기"
    },
    {
      "name": "Holidays",
      "displayName": "휴무일(설정)",
      "purpose": "영업일 계산용 회사 휴무일. 회사 공식 달력으로 관리.",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "휴무명",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "HolidayDate",
          "displayName": "휴무일",
          "type": "DateTime",
          "required": true,
          "dateOnly": true,
          "indexed": true
        }
      ],
      "permissions": "관리자 편집 / 팀원 읽기"
    },
    {
      "name": "FlowErrorLog",
      "displayName": "자동화 오류 로그(공통)",
      "purpose": "모든 파일럿 Flow의 Catch 블록이 기록하는 공통 로그(O20).",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "Flow 이름",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "FlowRunId",
          "displayName": "실행 ID",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "FailedAction",
          "displayName": "실패 액션",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "ErrorMessage",
          "displayName": "오류 메시지",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "RelatedItem",
          "displayName": "관련 항목",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "Severity",
          "displayName": "심각도",
          "type": "Choice",
          "required": true,
          "choices": [
            "Critical",
            "Warning"
          ]
        },
        {
          "internalName": "Resolved",
          "displayName": "조치완료",
          "type": "Boolean",
          "required": true,
          "default": false
        },
        {
          "internalName": "RunUrl",
          "displayName": "실행 기록 링크",
          "type": "Text",
          "required": false
        }
      ],
      "permissions": "자동화 운영자 편집 / 팀원 읽기"
    }
  ]
}
