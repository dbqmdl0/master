{
  "$comment": "Pilot 03 프로토타입 목록 구조(7개). 프로토타입은 본인 '내 목록'(OneDrive) 또는 팀 사이트에 SBX_ 접두어로 만든다. 운영 전환 시 같은 구조로 팀 사이트에 만든다.",
  "lists": [
    {
      "name": "ActionItems",
      "displayName": "액션 아이템",
      "versioning": true,
      "purpose": "결정·회의·메일에서 생긴 후속조치의 단일 원본. 회의록·주간보고·진행현황 회의를 대체한다.",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "할 일",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "ActionID",
          "displayName": "액션번호",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow"
        },
        {
          "internalName": "DecisionID",
          "displayName": "결정번호",
          "type": "Text",
          "required": false,
          "indexed": true
        },
        {
          "internalName": "Owner",
          "displayName": "담당자",
          "type": "User",
          "required": true,
          "indexed": true
        },
        {
          "internalName": "DueDate",
          "displayName": "기한",
          "type": "DateTime",
          "required": false,
          "dateOnly": true,
          "indexed": true
        },
        {
          "internalName": "Status",
          "displayName": "상태",
          "type": "Choice",
          "required": true,
          "indexed": true,
          "choices": [
            "미착수",
            "진행중",
            "완료",
            "보류",
            "취소"
          ],
          "default": "미착수"
        },
        {
          "internalName": "Priority",
          "displayName": "우선순위",
          "type": "Choice",
          "required": false,
          "choices": [
            "높음",
            "보통",
            "낮음"
          ],
          "default": "보통"
        },
        {
          "internalName": "ActionType",
          "displayName": "유형",
          "type": "Choice",
          "required": true,
          "choices": [
            "실행",
            "회신대기"
          ],
          "default": "실행"
        },
        {
          "internalName": "Source",
          "displayName": "출처",
          "type": "Choice",
          "required": false,
          "choices": [
            "회의",
            "이메일",
            "Teams 메시지",
            "업무요청",
            "기타"
          ],
          "default": "회의"
        },
        {
          "internalName": "SourceLink",
          "displayName": "원문 링크",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "Evidence",
          "displayName": "근거 문장",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "CompletedAt",
          "displayName": "완료일시",
          "type": "DateTime",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "ReminderCount",
          "displayName": "리마인더 횟수",
          "type": "Number",
          "required": false,
          "default": 0,
          "setBy": "flow"
        },
        {
          "internalName": "LastRemindedAt",
          "displayName": "최근 리마인더",
          "type": "DateTime",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "CreatedVia",
          "displayName": "등록 경로",
          "type": "Choice",
          "required": false,
          "choices": [
            "수동",
            "Teams 메시지",
            "Outlook 플래그",
            "AI 제안 승인"
          ],
          "default": "수동"
        },
        {
          "internalName": "DueHint",
          "displayName": "기한 근거",
          "type": "Text",
          "required": false,
          "setBy": "flow",
          "note": "메일 문구에서 추정한 기한의 근거(P3P-F13)"
        },
        {
          "internalName": "SourceMessageId",
          "displayName": "원본 메시지 ID(시스템)",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow",
          "hidden": true,
          "note": "같은 메일·메시지로 액션이 두 번 생기지 않게 하는 중복 방지 키"
        },
        {
          "internalName": "SourceKey",
          "displayName": "원본 고유키(시스템)",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow",
          "hidden": true,
          "note": "메일 이동·재플래그에도 변하지 않는 중복 방지 키. internetMessageId가 있으면 'imid|값', 없으면 'fp|발신자|수신시각|제목'(지문). 같은 메일=같은 키, 다른 메일은 합치지 않는다."
        },
        {
          "internalName": "FlagDue",
          "displayName": "자동 기한(시스템)",
          "type": "DateTime",
          "required": false,
          "dateOnly": true,
          "setBy": "flow",
          "hidden": true,
          "note": "자동화(플래그 기한·기본 기한·F13 추정)가 마지막으로 넣은 기한. 목록 기한이 이 값과 다르면 사람이 바꾼 것으로 보고 자동화가 덮어쓰지 않는다"
        },
        {
          "internalName": "SyncNote",
          "displayName": "동기화 메모",
          "type": "Note",
          "required": false,
          "setBy": "flow",
          "note": "자동화가 바꾸지 않고 사람 확인이 필요한 변화(완료 후 재플래그, 플래그 완료, 범주 변경, 기한 충돌, 중복 정리)를 날짜와 함께 남김"
        },
        {
          "internalName": "PrevStatus",
          "displayName": "이전 상태(시스템)",
          "type": "Text",
          "required": false,
          "setBy": "flow",
          "hidden": true
        },
        {
          "internalName": "DueHintChecked",
          "displayName": "기한 추정 완료(시스템)",
          "type": "Text",
          "required": false,
          "setBy": "flow",
          "hidden": true
        }
      ],
      "views": [
        {
          "name": "내 액션",
          "filter": "Owner = [Me] AND Status IN (미착수, 진행중)",
          "sort": "DueDate asc"
        },
        {
          "name": "기한 초과",
          "filter": "DueDate < [Today] AND Status IN (미착수, 진행중)",
          "sort": "DueDate asc"
        },
        {
          "name": "이번 주 완료",
          "filter": "Status = 완료 AND CompletedAt >= [Today]-7"
        },
        {
          "name": "보드",
          "type": "Board",
          "groupBy": "Status"
        }
      ],
      "permissions": "SCM 팀 및 회의 참석 부서 편집(본인 항목 상태 변경), 관리자 전체"
    },
    {
      "name": "DecisionLog",
      "displayName": "결정 레지스터",
      "versioning": true,
      "purpose": "회의·채팅·메일에서 나온 '결정'의 단일 원본. 결정 1건 = 1행. 근거와 번복 이력까지 남긴다.",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "결정 제목",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "DecisionID",
          "displayName": "결정번호",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow"
        },
        {
          "internalName": "DecisionText",
          "displayName": "결정 내용",
          "type": "Note",
          "required": true
        },
        {
          "internalName": "Rationale",
          "displayName": "근거·전제",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "OptionsConsidered",
          "displayName": "검토한 대안",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "FollowUps",
          "displayName": "후속 조치",
          "type": "Note",
          "required": false,
          "note": "확정 후 해야 할 일(액션번호 또는 내용). 확정 시 비어 있으면 확인 필요로 표시"
        },
        {
          "internalName": "ConfirmationGap",
          "displayName": "확정 확인 필요",
          "type": "Text",
          "required": false,
          "setBy": "flow",
          "note": "상태가 '확정'인데 결정권자·근거·후속 조치가 비어 있으면 무엇이 비었는지 표시(P3P-F4). 비어 있으면 확인 완료"
        },
        {
          "internalName": "Status",
          "displayName": "상태",
          "type": "Choice",
          "required": true,
          "indexed": true,
          "choices": [
            "제안",
            "결정요청",
            "확정",
            "보류",
            "번복",
            "취소"
          ],
          "default": "제안",
          "note": "제안=자동화·AI·메일 범주로 들어온 미확정 내용, 결정요청=결정권자 판단 대기, 확정=사람이 목록에서 직접 바꾼 경우만. 자동화는 '확정'을 만들지 않는다."
        },
        {
          "internalName": "Decider",
          "displayName": "결정권자",
          "type": "User",
          "required": false,
          "indexed": true,
          "note": "확정 시 사람이 입력. AI가 추정한 이름은 여기 넣지 않고 결정 내용에 '(AI 추정, 미확인)'으로만 남긴다"
        },
        {
          "internalName": "RequestedBy",
          "displayName": "결정 요청자",
          "type": "User",
          "required": false
        },
        {
          "internalName": "RequestedAt",
          "displayName": "결정 요청일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "DecidedAt",
          "displayName": "확정일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "MeetingName",
          "displayName": "회의명",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "MeetingDate",
          "displayName": "회의일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "Impact",
          "displayName": "영향도",
          "type": "Choice",
          "required": false,
          "choices": [
            "고",
            "중",
            "저"
          ],
          "default": "중"
        },
        {
          "internalName": "ReviewDate",
          "displayName": "재검토일",
          "type": "DateTime",
          "required": false,
          "dateOnly": true
        },
        {
          "internalName": "SourceLink",
          "displayName": "원문 링크",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "RelatedRequestID",
          "displayName": "관련 요청번호",
          "type": "Text",
          "required": false,
          "indexed": true
        },
        {
          "internalName": "SupersededBy",
          "displayName": "대체한 결정번호",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "CreatedVia",
          "displayName": "등록 경로",
          "type": "Choice",
          "required": false,
          "choices": [
            "수동",
            "Teams 메시지",
            "Outlook 플래그",
            "AI 제안 승인"
          ],
          "default": "수동"
        },
        {
          "internalName": "PrevStatus",
          "displayName": "이전 상태(시스템)",
          "type": "Text",
          "required": false,
          "setBy": "flow",
          "hidden": true
        },
        {
          "internalName": "SourceMessageId",
          "displayName": "원본 메시지 ID(시스템)",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow",
          "hidden": true
        },
        {
          "internalName": "SourceKey",
          "displayName": "원본 고유키(시스템)",
          "type": "Text",
          "required": false,
          "indexed": true,
          "setBy": "flow",
          "hidden": true
        },
        {
          "internalName": "SyncNote",
          "displayName": "동기화 메모",
          "type": "Note",
          "required": false,
          "setBy": "flow"
        }
      ],
      "views": [
        {
          "name": "확정 대기 제안",
          "filter": "Status = 제안",
          "sort": "Created asc"
        },
        {
          "name": "결정 대기열",
          "filter": "Status = 결정요청",
          "sort": "RequestedAt asc"
        },
        {
          "name": "나의 결정 대기",
          "filter": "Status = 결정요청 AND Decider = [Me]",
          "sort": "RequestedAt asc"
        },
        {
          "name": "최근 확정 30일",
          "filter": "Status = 확정 AND DecidedAt >= [Today]-30",
          "sort": "DecidedAt desc"
        },
        {
          "name": "재검토 도래",
          "filter": "ReviewDate <= [Today]+7 AND Status = 확정"
        },
        {
          "name": "확정 확인 필요",
          "filter": "Status = 확정 AND ConfirmationGap is not empty"
        }
      ],
      "permissions": "SCM 팀 편집 / 협업 부서 읽기(결정 공유가 목적). 민감 결정은 별도 목록 또는 항목 권한."
    },
    {
      "name": "MeetingIntake",
      "displayName": "회의 추출 접수",
      "versioning": true,
      "purpose": "Copilot이 만든 결정·액션 JSON과 회의록 원문을 붙여넣는 접수 목록. 저장하면 검증 흐름(P3P-F8)이 자동 실행된다.",
      "columns": [
        {
          "internalName": "Title",
          "displayName": "회의명",
          "type": "Text",
          "required": true
        },
        {
          "internalName": "MeetingDate",
          "displayName": "회의일",
          "type": "DateTime",
          "required": true,
          "dateOnly": true
        },
        {
          "internalName": "Transcript",
          "displayName": "회의록 원문",
          "type": "Note",
          "required": true,
          "note": "전사본·메모 원문. 근거 검사(G2)에 사용"
        },
        {
          "internalName": "ExtractionJson",
          "displayName": "Copilot 추출 결과",
          "type": "Note",
          "required": true,
          "note": "Copilot 응답 전체를 그대로 붙여넣기(코드 블록 표시 포함 가능)"
        },
        {
          "internalName": "Status",
          "displayName": "처리 상태",
          "type": "Choice",
          "required": true,
          "choices": [
            "접수",
            "검증완료",
            "오류",
            "재검증요청"
          ],
          "default": "접수"
        },
        {
          "internalName": "RecommendedCount",
          "displayName": "추천 후보 수",
          "type": "Number",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "ReviewCount",
          "displayName": "검토필요 후보 수",
          "type": "Number",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "ResultSummary",
          "displayName": "검증 요약",
          "type": "Note",
          "required": false,
          "setBy": "flow"
        },
        {
          "internalName": "ProcessedAt",
          "displayName": "처리 시각",
          "type": "DateTime",
          "required": false,
          "setBy": "flow"
        }
      ],
      "views": [
        {
          "name": "최근 접수",
          "sort": "Created desc"
        }
      ],
      "permissions": "본인(프로토타입) → SCM 팀 편집(운영)"
    },
